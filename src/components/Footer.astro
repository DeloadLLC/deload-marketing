---
import Wordmark from "./Wordmark.astro";
import {
  FEATURES,
  BUSINESS_TYPES,
  RESOURCES,
  SIGN_IN_URL,
  PRIMARY_CTA,
  PRIVACY_URL,
  TERMS_URL,
} from "../config";

interface Props {
  // Pages whose own form or closing band is the call to action hide the
  // footer's sign-up band.
  hideCta?: boolean;
}
const { hideCta = false } = Astro.props;

const base = import.meta.env.BASE_URL;
const root = base.replace(/\/$/, "");
const link = (href: string) =>
  href.startsWith("http") ? href : `${root}${href}`;
const year = new Date().getFullYear();

// Keep the footer feature list tight — the most marketable surfaces.
const footerFeatures = FEATURES.filter((f) =>
  ["ai-programming", "program-editing", "program-import", "roster", "athlete-app", "marketplace"].includes(f.slug),
);

const company = [
  { label: "Why we're different", href: "/why" },
  { label: "Deload Foundations", href: "/elevate" },
  { label: "Pricing", href: "/pricing" },
  { label: "About", href: "/about" },
  { label: "Book a demo", href: "/book-a-demo" },
  { label: "Contact", href: "/contact" },
];

const legal = [
  { label: "Privacy", href: PRIVACY_URL },
  { label: "Terms", href: TERMS_URL },
];
const colHead = "mb-4 text-[0.8125rem] font-medium text-ink";
const colList = "space-y-2.5 text-[0.9375rem] text-muted";
const colLink = "transition-colors hover:text-ink";
---
<footer class="border-t border-rule bg-bg">
  {!hideCta && (
    <div class="border-b border-rule">
      <div class="wrap flex flex-col items-start gap-6 py-14 md:flex-row md:items-end md:justify-between md:py-16">
        <p class="h2 max-w-[22ch] text-ink">
          Give the programming, the roster, and the admin to one app.
        </p>
        <div class="flex flex-wrap gap-2">
          <a href={PRIMARY_CTA.href} class="btn btn-pri btn-lg">{PRIMARY_CTA.label}</a>
          <a href={link("/book-a-demo")} class="btn btn-lg">Book a demo</a>
        </div>
      </div>
    </div>
  )}

  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-10 py-14 md:grid-cols-[1.4fr_repeat(4,1fr)]">
    <div class="col-span-2 md:col-span-1">
      <a href={link("/")} aria-label="deload home" class="text-ink"><Wordmark /></a>
      <p class="mt-4 max-w-[30ch] text-[0.9375rem] text-muted">
        The all-in-one AI coaching platform for coaches who write their own training.
      </p>
    </div>

    <div>
      <p class={colHead}>Features</p>
      <ul class={colList}>
        {footerFeatures.map((f) => (
          <li><a class={colLink} href={link(`/features/${f.slug}`)}>{f.nav}</a></li>
        ))}
        <li><a class={colLink} href={link("/features")}>All features</a></li>
      </ul>
    </div>

    <div>
      <p class={colHead}>Business types</p>
      <ul class={colList}>
        {BUSINESS_TYPES.map((b) => (
          <li>
            <a class={colLink} href={link(`/business-types/${b.slug}`)}>{b.nav}</a>
            {b.comingSoon && <span class="soon ml-1">Soon</span>}
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class={colHead}>Resources</p>
      <ul class={colList}>
        {RESOURCES.map((r) => (
          <li><a class={colLink} href={link(`/resources/${r.slug}`)}>{r.nav}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class={colHead}>Company</p>
      <ul class={colList}>
        {company.map((c) => (
          <li><a class={colLink} href={link(c.href)}>{c.label}</a></li>
        ))}
        <li><a class={colLink} href={SIGN_IN_URL}>Sign in</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-rule">
    <div class="wrap flex flex-col gap-3 py-6 text-[0.8125rem] text-muted md:flex-row md:items-center md:justify-between">
      <span>&copy; <span class="num">{year}</span> Deload. All rights reserved.</span>
      <nav class="flex flex-wrap items-center gap-x-6 gap-y-2" aria-label="Legal">
        {legal.map((l) => (
          <a class={colLink} href={link(l.href)}>{l.label}</a>
        ))}
      </nav>
    </div>
  </div>
</footer>
