---
import {
  SIGN_IN_URL,
  PRIMARY_CTA,
  FEATURES,
  FEATURE_GROUPS,
  BUSINESS_TYPES,
  RESOURCES,
  getFeature,
} from "../config";
import Wordmark from "./Wordmark.astro";

const base = import.meta.env.BASE_URL;
const root = base.replace(/\/$/, "");
const link = (href: string) =>
  href.startsWith("http") ? href : `${root}${href}`;

const featureColumns = FEATURE_GROUPS.map((group) => ({
  heading: group.heading,
  items: group.slugs
    .map((slug) => getFeature(slug))
    .filter((f): f is NonNullable<typeof f> => Boolean(f)),
}));
---
<header class="sticky top-0 z-50 border-b border-ink/10 bg-bg/90 backdrop-blur">
  <div class="mx-auto flex max-w-container items-center justify-between gap-4 px-6 py-4">
    <a href={link("/")} class="text-ink hover:opacity-80" aria-label="deload home">
      <Wordmark class="text-base" />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-5 text-[13px] font-medium tracking-tight text-ink/80 xl:flex 2xl:gap-8">
      <a href={link("/why")} class="whitespace-nowrap uppercase tracking-[0.1em] transition-colors hover:text-ink">Why we're different</a>

      <!-- Features mega-menu -->
      <div class="group relative">
        <button
          class="flex items-center gap-1 whitespace-nowrap uppercase tracking-[0.1em] transition-colors hover:text-ink"
          aria-haspopup="true"
        >
          Features
          <svg class="h-3.5 w-3.5 opacity-60 transition-transform group-hover:rotate-180" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="invisible absolute left-1/2 top-full z-50 w-[min(56rem,90vw)] -translate-x-1/2 pt-3 opacity-0 transition-opacity duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          <div class="grid grid-cols-2 gap-x-8 gap-y-6 rounded-2xl border border-ink/10 bg-bg p-7 shadow-xl shadow-ink/5 md:grid-cols-4">
            {featureColumns.map((col) => (
              <div>
                <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.16em] text-clay">{col.heading}</p>
                <ul class="space-y-3">
                  {col.items.map((f) => (
                    <li>
                      <a href={link(`/features/${f.slug}`)} class="block text-sm font-medium text-ink transition-colors hover:text-clay">
                        {f.nav}
                        {f.status === "soon" && (
                          <span class="ml-1.5 inline-block whitespace-nowrap rounded-full bg-sage/15 px-1.5 py-0.5 align-middle text-[10px] font-medium uppercase tracking-wide text-sage">Coming soon</span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Business types -->
      <div class="group relative">
        <button class="flex items-center gap-1 whitespace-nowrap uppercase tracking-[0.1em] transition-colors hover:text-ink" aria-haspopup="true">
          Business types
          <svg class="h-3.5 w-3.5 opacity-60 transition-transform group-hover:rotate-180" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="invisible absolute left-0 top-full z-50 w-80 pt-3 opacity-0 transition-opacity duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          <ul class="space-y-1 rounded-2xl border border-ink/10 bg-bg p-3 shadow-xl shadow-ink/5">
            {BUSINESS_TYPES.map((b) => (
              <li>
                <a href={link(`/business-types/${b.slug}`)} class="block rounded-xl px-3 py-2 text-sm font-medium text-ink transition-colors hover:bg-ink/5">
                  {b.nav}
                  {b.comingSoon && (
                    <span class="ml-1.5 inline-block whitespace-nowrap rounded-full bg-sage/15 px-1.5 py-0.5 align-middle text-[10px] font-medium uppercase tracking-wide text-sage">Coming soon</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Resources -->
      <div class="group relative">
        <button class="flex items-center gap-1 whitespace-nowrap uppercase tracking-[0.1em] transition-colors hover:text-ink" aria-haspopup="true">
          Resources
          <svg class="h-3.5 w-3.5 opacity-60 transition-transform group-hover:rotate-180" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="invisible absolute left-0 top-full z-50 w-80 pt-3 opacity-0 transition-opacity duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          <ul class="space-y-1 rounded-2xl border border-ink/10 bg-bg p-3 shadow-xl shadow-ink/5">
            {RESOURCES.map((r) => (
              <li>
                <a href={link(`/resources/${r.slug}`)} class="block rounded-xl px-3 py-2 text-sm font-medium text-ink transition-colors hover:bg-ink/5">
                  {r.nav}
                  {r.comingSoon && (
                    <span class="ml-1.5 inline-block whitespace-nowrap rounded-full bg-sage/15 px-1.5 py-0.5 align-middle text-[10px] font-medium uppercase tracking-wide text-sage">Coming soon</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <a href={link("/pricing")} class="whitespace-nowrap uppercase tracking-[0.1em] transition-colors hover:text-ink">Pricing</a>
      <a href={SIGN_IN_URL} class="whitespace-nowrap uppercase tracking-[0.1em] transition-colors hover:text-ink">Login</a>
    </nav>

    <!-- CTAs -->
    <div class="hidden items-center gap-2 xl:flex">
      <a href={PRIMARY_CTA.href} class="whitespace-nowrap rounded-full border border-ink/20 px-3.5 py-1.5 text-sm font-semibold uppercase tracking-[0.08em] text-ink transition-colors hover:bg-ink/5">{PRIMARY_CTA.label}</a>
      <a href={link("/book-a-demo")} class="whitespace-nowrap rounded-full bg-ink px-3.5 py-1.5 text-sm font-semibold uppercase tracking-[0.08em] text-bg transition-colors hover:bg-ink/90">Book a demo</a>
    </div>

    <!-- Mobile toggle -->
    <button
      id="menu-toggle"
      class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-ink/15 text-ink xl:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-ink/10 bg-bg xl:hidden">
    <nav class="mx-auto max-w-container space-y-1 px-6 py-4 text-sm">
      <a href={link("/why")} class="block rounded-lg px-3 py-2.5 font-medium text-ink hover:bg-ink/5">Why we're different</a>

      <details class="group">
        <summary class="flex cursor-pointer items-center justify-between rounded-lg px-3 py-2.5 font-medium text-ink hover:bg-ink/5">Features<span class="text-ink/40 group-open:rotate-180">▾</span></summary>
        <ul class="space-y-0.5 pb-2 pl-3">
          {FEATURES.map((f) => (
            <li><a href={link(`/features/${f.slug}`)} class="block rounded-lg px-3 py-2 text-ink/75 hover:bg-ink/5">{f.nav}{f.status === "soon" && <span class="ml-1.5 text-[10px] uppercase tracking-wide text-sage">coming soon</span>}</a></li>
          ))}
        </ul>
      </details>

      <details class="group">
        <summary class="flex cursor-pointer items-center justify-between rounded-lg px-3 py-2.5 font-medium text-ink hover:bg-ink/5">Business types<span class="text-ink/40 group-open:rotate-180">▾</span></summary>
        <ul class="space-y-0.5 pb-2 pl-3">
          {BUSINESS_TYPES.map((b) => (
            <li><a href={link(`/business-types/${b.slug}`)} class="block rounded-lg px-3 py-2 text-ink/75 hover:bg-ink/5">{b.nav}{b.comingSoon && <span class="ml-1.5 text-[10px] uppercase tracking-wide text-sage">coming soon</span>}</a></li>
          ))}
        </ul>
      </details>

      <details class="group">
        <summary class="flex cursor-pointer items-center justify-between rounded-lg px-3 py-2.5 font-medium text-ink hover:bg-ink/5">Resources<span class="text-ink/40 group-open:rotate-180">▾</span></summary>
        <ul class="space-y-0.5 pb-2 pl-3">
          {RESOURCES.map((r) => (
            <li><a href={link(`/resources/${r.slug}`)} class="block rounded-lg px-3 py-2 text-ink/75 hover:bg-ink/5">{r.nav}</a></li>
          ))}
        </ul>
      </details>

      <a href={link("/pricing")} class="block rounded-lg px-3 py-2.5 font-medium text-ink hover:bg-ink/5">Pricing</a>
      <a href={SIGN_IN_URL} class="block rounded-lg px-3 py-2.5 font-medium text-ink hover:bg-ink/5">Login</a>

      <div class="flex flex-col gap-2 pt-3">
        <a href={PRIMARY_CTA.href} class="rounded-full border border-ink/20 px-4 py-2.5 text-center text-sm font-semibold uppercase tracking-[0.08em] text-ink hover:bg-ink/5">{PRIMARY_CTA.label}</a>
        <a href={link("/book-a-demo")} class="rounded-full bg-ink px-4 py-2.5 text-center text-sm font-semibold uppercase tracking-[0.08em] text-bg hover:bg-ink/90">Book a demo</a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById("menu-toggle");
    var menu = document.getElementById("mobile-menu");
    if (!btn || !menu) return;
    btn.addEventListener("click", function () {
      var open = menu.classList.toggle("hidden") === false;
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    });
  })();
</script>
