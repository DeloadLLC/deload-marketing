---
import {
  SIGN_IN_URL,
  PRIMARY_CTA,
  FEATURES,
  FEATURE_GROUPS,
  BUSINESS_TYPES,
  RESOURCES,
  getFeature,
} from "../config";
import Wordmark from "./Wordmark.astro";

const base = import.meta.env.BASE_URL;
const root = base.replace(/\/$/, "");
const link = (href: string) =>
  href.startsWith("http") ? href : `${root}${href}`;

const featureColumns = FEATURE_GROUPS.map((group) => ({
  heading: group.heading,
  items: group.slugs
    .map((slug) => getFeature(slug))
    .filter((f): f is NonNullable<typeof f> => Boolean(f)),
}));

const chevron = `<svg class="h-3 w-3 opacity-60 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const navLink = "whitespace-nowrap rounded-lg px-2.5 py-2 text-muted transition-colors hover:text-ink";
const menuPanel =
  "invisible absolute top-full z-50 pt-2 opacity-0 transition-[opacity,transform] duration-200 ease-out -translate-y-1 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 motion-reduce:transition-none";
const panelBox = "rounded-2xl border border-rule bg-surface shadow-[0_18px_40px_-20px_rgb(0_0_0/0.25)]";
---
<header class="sticky top-0 z-50 border-b border-rule/70 bg-bg/90 backdrop-blur-md">
  <div class="wrap flex h-16 items-center gap-6">
    <a href={link("/")} class="shrink-0 text-ink" aria-label="deload home">
      <Wordmark />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-1 text-[0.9375rem] xl:flex" aria-label="Main">
      <div class="group relative">
        <button class={`${navLink} flex items-center gap-1.5`} aria-haspopup="true">Features <Fragment set:html={chevron} /></button>
        <div class={`${menuPanel} left-0 w-[min(58rem,90vw)]`}>
          <div class={`${panelBox} grid grid-cols-4 gap-x-8 p-7`}>
            {featureColumns.map((col) => (
              <div>
                <p class="mb-3 text-[0.8125rem] font-medium text-muted">{col.heading}</p>
                <ul class="space-y-2.5">
                  {col.items.map((f) => (
                    <li>
                      <a href={link(`/features/${f.slug}`)} class="block text-[0.9375rem] font-medium leading-snug text-ink transition-colors hover:text-clay">
                        {f.nav}
                        {f.status === "soon" && <span class="soon ml-1">Coming soon</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="group relative">
        <button class={`${navLink} flex items-center gap-1.5`} aria-haspopup="true">Business types <Fragment set:html={chevron} /></button>
        <div class={`${menuPanel} left-0 w-80`}>
          <ul class={`${panelBox} p-2`}>
            {BUSINESS_TYPES.map((b) => (
              <li>
                <a href={link(`/business-types/${b.slug}`)} class="block rounded-xl px-3 py-2.5 text-[0.9375rem] font-medium text-ink transition-colors hover:bg-sunk">
                  {b.nav}
                  {b.comingSoon && <span class="soon ml-1">Coming soon</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <a href={link("/why")} class={navLink}>Why we're different</a>
      <a href={link("/pricing")} class={navLink}>Pricing</a>

      <div class="group relative">
        <button class={`${navLink} flex items-center gap-1.5`} aria-haspopup="true">Resources <Fragment set:html={chevron} /></button>
        <div class={`${menuPanel} left-0 w-80`}>
          <ul class={`${panelBox} p-2`}>
            {RESOURCES.map((r) => (
              <li>
                <a href={link(`/resources/${r.slug}`)} class="block rounded-xl px-3 py-2.5 text-[0.9375rem] font-medium text-ink transition-colors hover:bg-sunk">
                  {r.nav}
                  {r.comingSoon && <span class="soon ml-1">Coming soon</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </nav>

    <div class="ml-auto hidden items-center gap-2 xl:flex">
      <a href={SIGN_IN_URL} class={`${navLink} mr-1`}>Sign in</a>
      <a href={link("/book-a-demo")} class="btn">Book a demo</a>
      <a href={PRIMARY_CTA.href} class="btn btn-pri">{PRIMARY_CTA.label}</a>
    </div>

    <!-- Phone and iPad: the sign-up button stays in reach, the rest folds into the menu -->
    <div class="ml-auto flex items-center gap-2 xl:hidden">
      <a href={PRIMARY_CTA.href} class="btn btn-pri hidden sm:inline-flex">{PRIMARY_CTA.label}</a>
      <button
        id="menu-toggle"
        class="btn h-11 w-11 !px-0"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path data-open d="M4 8h16M4 16h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path data-close class="hidden" d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>

  <!-- Phone and iPad menu -->
  <div id="mobile-menu" class="hidden max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-rule bg-bg xl:hidden">
    <nav class="wrap py-4" aria-label="Main">
      <ul class="divide-y divide-rule border-b border-rule text-[1.0625rem]">
        <li>
          <details class="group">
            <summary class="flex min-h-[52px] cursor-pointer list-none items-center justify-between font-medium text-ink">Features <Fragment set:html={chevron} /></summary>
            <ul class="grid gap-x-6 pb-3 sm:grid-cols-2">
              {FEATURES.map((f) => (
                <li><a href={link(`/features/${f.slug}`)} class="flex min-h-[44px] items-center gap-2 text-muted hover:text-ink">{f.nav}{f.status === "soon" && <span class="soon">Soon</span>}</a></li>
              ))}
            </ul>
          </details>
        </li>
        <li>
          <details class="group">
            <summary class="flex min-h-[52px] cursor-pointer list-none items-center justify-between font-medium text-ink">Business types <Fragment set:html={chevron} /></summary>
            <ul class="grid gap-x-6 pb-3 sm:grid-cols-2">
              {BUSINESS_TYPES.map((b) => (
                <li><a href={link(`/business-types/${b.slug}`)} class="flex min-h-[44px] items-center gap-2 text-muted hover:text-ink">{b.nav}{b.comingSoon && <span class="soon">Soon</span>}</a></li>
              ))}
            </ul>
          </details>
        </li>
        <li><a href={link("/why")} class="flex min-h-[52px] items-center font-medium text-ink">Why we're different</a></li>
        <li><a href={link("/pricing")} class="flex min-h-[52px] items-center font-medium text-ink">Pricing</a></li>
        <li>
          <details class="group">
            <summary class="flex min-h-[52px] cursor-pointer list-none items-center justify-between font-medium text-ink">Resources <Fragment set:html={chevron} /></summary>
            <ul class="grid gap-x-6 pb-3 sm:grid-cols-2">
              {RESOURCES.map((r) => (
                <li><a href={link(`/resources/${r.slug}`)} class="flex min-h-[44px] items-center text-muted hover:text-ink">{r.nav}</a></li>
              ))}
            </ul>
          </details>
        </li>
        <li><a href={SIGN_IN_URL} class="flex min-h-[52px] items-center font-medium text-ink">Sign in</a></li>
      </ul>
      <div class="grid gap-2 pt-5 sm:grid-cols-2">
        <a href={PRIMARY_CTA.href} class="btn btn-pri btn-lg">{PRIMARY_CTA.label}</a>
        <a href={link("/book-a-demo")} class="btn btn-lg">Book a demo</a>
      </div>
    </nav>
  </div>
</header>

<style>
  summary::-webkit-details-marker { display: none; }
  details[open] > summary :global(svg) { transform: rotate(180deg); }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById("menu-toggle");
    var menu = document.getElementById("mobile-menu");
    if (!btn || !menu) return;
    function set(open) {
      menu.classList.toggle("hidden", !open);
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      btn.querySelector("[data-open]").classList.toggle("hidden", open);
      btn.querySelector("[data-close]").classList.toggle("hidden", !open);
    }
    btn.addEventListener("click", function () { set(menu.classList.contains("hidden")); });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && !menu.classList.contains("hidden")) { set(false); btn.focus(); }
    });
  })();
</script>
