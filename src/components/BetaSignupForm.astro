---
// Join Waitlist form (private beta). Posts to deload-backend's
// /api/public/beta-signup (NOT the generic contact endpoint), which saves
// the signup to the beta list, adds it to Clerk's waitlist and emails the
// questionnaire. On success it swaps to an inline "what's next" state with
// the questionnaire link, social links and a news opt-in.
//
// Spam protection mirrors LeadForm: a hidden `companyName` honeypot +
// invisible Cloudflare Turnstile. This form ships its own client
// script (the payload shape differs from LeadForm's), keyed off
// `data-beta-endpoint` so it never collides with LeadForm's handler.
import {
  API_BASE_URL,
  BETA_SIGNUP_ENDPOINT,
  TURNSTILE_SITE_KEY,
  BETA_ROSTER_OPTIONS,
  BETA_COACHING_TYPE_OPTIONS,
  ACTIVE_SOCIALS,
} from "../config";

interface Props {
  id?: string;
  submitLabel?: string;
}

const { id = "beta-form", submitLabel = "Join Waitlist" } = Astro.props;

const inputClass =
  "mt-1.5 block w-full rounded-lg border border-ink/15 bg-bg px-3 py-2.5 text-ink placeholder:text-ink/40 focus:border-ink focus:outline-none";
const nextSteps = [
  "Check your inbox — we just sent you a short questionnaire.",
  "Answering it confirms your email and helps us invite the right coaches first.",
  "We invite coaches in small groups; your invitation arrives by email.",
];
---
<div id={`${id}-wrap`} data-api-base={API_BASE_URL.replace(/\/$/, "")}>
  <!-- Signup form -->
  <form
    id={id}
    data-beta-endpoint={BETA_SIGNUP_ENDPOINT}
    data-turnstile-sitekey={TURNSTILE_SITE_KEY}
    class="space-y-4 rounded-2xl border border-ink/10 bg-bg p-6 shadow-sm md:p-8"
    novalidate
  >
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block">
        <span class="text-sm font-medium text-ink">Name</span>
        <input type="text" name="name" required maxlength="120"
          class={inputClass} placeholder="Your name" />
      </label>
      <label class="block">
        <span class="text-sm font-medium text-ink">Work email</span>
        <input type="email" name="email" required maxlength="254"
          class={inputClass} placeholder="you@yourgym.com" />
        <span id={`${id}-email-hint`} class="mt-1 hidden text-xs text-clay"></span>
      </label>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block">
        <span class="text-sm font-medium text-ink">Business / gym <span class="text-ink/40">(optional)</span></span>
        <input type="text" name="company" maxlength="120"
          class={inputClass} placeholder="Your gym or studio" />
      </label>
      <label class="block">
        <span class="text-sm font-medium text-ink">How do you coach?</span>
        <select name="coachingType" class={inputClass}>
          <option value="">Select…</option>
          {BETA_COACHING_TYPE_OPTIONS.map((o) => <option value={o.value}>{o.label}</option>)}
        </select>
      </label>
    </div>

    <label class="block">
      <span class="text-sm font-medium text-ink">How many athletes do you coach?</span>
      <select name="rosterBucket" class={inputClass}>
        <option value="">Select…</option>
        {BETA_ROSTER_OPTIONS.map((o) => <option value={o.value}>{o.label}</option>)}
      </select>
    </label>

    <label class="flex items-start gap-2.5">
      <input type="checkbox" name="consentMarketing" value="true"
        class="mt-0.5 h-4 w-4 rounded border-ink/30 text-ink focus:ring-ink/30" />
      <span class="text-sm text-ink/70">Send me Deload product news and early-access updates.</span>
    </label>

    {/* Honeypot — real browsers leave this blank; bots fill it. */}
    <div class="hidden" aria-hidden="true">
      <label>Company name<input type="text" name="companyName" tabindex="-1" autocomplete="off" /></label>
    </div>

    <div id={`${id}-turnstile`} class="cf-turnstile" aria-hidden="true"></div>

    <div class="flex flex-wrap items-center gap-4">
      <button type="submit" id={`${id}-submit`}
        class="rounded-full bg-ink px-6 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-bg transition-colors hover:bg-ink/90 disabled:opacity-60">{submitLabel}</button>
      <p id={`${id}-status`} class="text-sm text-ink/60" role="status" aria-live="polite"></p>
    </div>
  </form>

  <!-- Success state (revealed after a successful submit) -->
  <div id={`${id}-success`} class="hidden rounded-2xl border border-sage/30 bg-sage/5 p-6 shadow-sm md:p-8">
    <p class="inline-flex items-center gap-2 rounded-full border border-sage/30 bg-sage/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-sage">
      <span aria-hidden="true" class="inline-block h-1.5 w-1.5 rounded-full bg-sage"></span>
      You're on the list
    </p>
    <h3 class="mt-4 text-2xl font-medium tracking-tight text-ink">Welcome — here's what happens next.</h3>
    <ol class="mt-5 space-y-3">
      {nextSteps.map((step, i) => (
        <li class="flex items-start gap-3 text-sm text-ink/80">
          <span class="mt-0.5 flex h-5 w-5 flex-none items-center justify-center rounded-full bg-ink text-[11px] font-semibold text-bg">{i + 1}</span>
          <span>{step}</span>
        </li>
      ))}
    </ol>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <a id={`${id}-questionnaire-link`} href="#"
        class="rounded-full bg-ink px-5 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-bg transition-colors hover:bg-ink/90">Answer the questionnaire</a>
      <a id={`${id}-subscribe-link`} href="#"
        class="hidden rounded-full border border-ink/20 px-5 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-ink transition-colors hover:bg-ink/5">Get product news &amp; updates</a>
      <span id={`${id}-subscribed-note`} class="hidden text-sm text-sage">✓ You're subscribed to updates.</span>
    </div>

    {ACTIVE_SOCIALS.length > 0 && (
      <div class="mt-7 border-t border-ink/10 pt-5">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-clay">While you wait, follow along</p>
        <div class="mt-3 flex flex-wrap gap-3">
          {ACTIVE_SOCIALS.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer"
              class="rounded-full border border-ink/15 px-4 py-2 text-sm font-medium text-ink transition-colors hover:bg-ink/5">{s.label}</a>
          ))}
        </div>
      </div>
    )}
  </div>
</div>

<script>
  interface TurnstileApi {
    render: (c: HTMLElement | string, o: Record<string, unknown>) => string;
    getResponse: (id?: string) => string | undefined;
    reset: (id?: string) => void;
    execute: (id?: string) => void;
  }
  interface WindowWithTurnstile extends Window {
    turnstile?: TurnstileApi;
  }
  const w = window as WindowWithTurnstile;

  // Free/personal email providers — CLIENT HINT ONLY. The server runs the
  // authoritative soft filter; we never block here, just nudge.
  const FREE_DOMAINS = new Set([
    "gmail.com", "googlemail.com", "outlook.com", "hotmail.com", "live.com",
    "yahoo.com", "ymail.com", "icloud.com", "me.com", "aol.com",
    "proton.me", "protonmail.com",
  ]);

  const forms = Array.from(document.querySelectorAll<HTMLFormElement>("form[data-beta-endpoint]"));
  for (const form of forms) {
    const id = form.id;
    const wrap = document.getElementById(`${id}-wrap`);
    const submitBtn = document.getElementById(`${id}-submit`) as HTMLButtonElement | null;
    const status = document.getElementById(`${id}-status`);
    const turnstileEl = document.getElementById(`${id}-turnstile`) as HTMLElement | null;
    const successEl = document.getElementById(`${id}-success`);
    const emailInput = form.querySelector<HTMLInputElement>('input[name="email"]');
    const emailHint = document.getElementById(`${id}-email-hint`);
    if (!submitBtn || !status) continue;

    // Gentle work-email nudge (non-blocking).
    if (emailInput && emailHint) {
      emailInput.addEventListener("blur", () => {
        const domain = (emailInput.value.split("@").pop() || "").trim().toLowerCase();
        if (domain && FREE_DOMAINS.has(domain)) {
          emailHint.textContent = "Tip: a work email helps us prioritise your spot — but a personal one is fine too.";
          emailHint.classList.remove("hidden");
        } else {
          emailHint.classList.add("hidden");
        }
      });
    }

    let widgetId: string | undefined;
    const siteKey = (form.dataset.turnstileSitekey || "").trim();
    if (turnstileEl && siteKey) {
      const ensureScript = (): Promise<void> => new Promise((resolve) => {
        if (w.turnstile) { resolve(); return; }
        const existing = document.querySelector('script[data-deload-turnstile="1"]') as HTMLScriptElement | null;
        if (existing) { existing.addEventListener("load", () => resolve(), { once: true }); return; }
        const s = document.createElement("script");
        s.src = "https://challenges.cloudflare.com/turnstile/v0/api.js";
        s.async = true; s.defer = true; s.dataset.deloadTurnstile = "1";
        s.addEventListener("load", () => resolve(), { once: true });
        document.head.appendChild(s);
      });
      ensureScript().then(() => {
        if (!w.turnstile || !turnstileEl) return;
        widgetId = w.turnstile.render(turnstileEl, {
          sitekey: siteKey, size: "invisible", appearance: "interaction-only",
          retry: "auto", "refresh-expired": "auto",
        });
      });
    }

    const endpoint = form.dataset.betaEndpoint || "";
    const apiBase = (wrap?.dataset.apiBase || "").replace(/\/$/, "");

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      let token = "";
      if (siteKey && w.turnstile) {
        token = w.turnstile.getResponse(widgetId) || "";
        if (!token) {
          try { w.turnstile.execute(widgetId); } catch {}
          const deadline = Date.now() + 6000;
          while (Date.now() < deadline && !token) {
            await new Promise((r) => setTimeout(r, 150));
            token = w.turnstile.getResponse(widgetId) || "";
          }
        }
      }

      const name = String(data.get("name") || "").trim();
      const email = String(data.get("email") || "").trim();
      const consentMarketing = data.get("consentMarketing") === "true";
      if (!name || !email) {
        status.textContent = "Please fill in your name and email.";
        status.className = "text-sm text-red-600";
        return;
      }

      const payload = {
        name,
        email,
        company: String(data.get("company") || "").trim(),
        rosterBucket: String(data.get("rosterBucket") || "").trim(),
        coachingType: String(data.get("coachingType") || "").trim(),
        consentMarketing,
        companyName: String(data.get("companyName") || ""), // honeypot
        turnstileToken: token,
        sourceUrl: window.location.href,
      };

      submitBtn.disabled = true;
      const original = submitBtn.textContent;
      submitBtn.textContent = "Joining…";
      status.textContent = "";
      status.className = "text-sm text-ink/60";
      try {
        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          let publicToken = "";
          let questionnaireUrl = "";
          try {
            const j = await res.json();
            if (j && typeof j.publicToken === "string") publicToken = j.publicToken;
            if (j && typeof j.questionnaireUrl === "string") questionnaireUrl = j.questionnaireUrl;
          } catch {}

          // Wire the success-state links.
          const qLink = document.getElementById(`${id}-questionnaire-link`) as HTMLAnchorElement | null;
          if (qLink && questionnaireUrl) qLink.href = questionnaireUrl;
          else if (qLink) qLink.classList.add("hidden");

          const subLink = document.getElementById(`${id}-subscribe-link`) as HTMLAnchorElement | null;
          const subNote = document.getElementById(`${id}-subscribed-note`);
          if (consentMarketing) {
            subNote?.classList.remove("hidden");
          } else if (subLink && publicToken && apiBase) {
            subLink.href = `${apiBase}/api/public/beta/subscribe/${encodeURIComponent(publicToken)}`;
            subLink.classList.remove("hidden");
          }

          form.classList.add("hidden");
          successEl?.classList.remove("hidden");
          successEl?.scrollIntoView({ behavior: "smooth", block: "center" });
        } else {
          let detail = "";
          try { const j = await res.json(); if (j && typeof j.error === "string") detail = j.error; } catch {}
          status.textContent = detail ? `Couldn't sign up: ${detail}.` : "Couldn't sign up right now. Please try again.";
          status.className = "text-sm text-red-600";
          submitBtn.disabled = false;
          submitBtn.textContent = original;
        }
      } catch {
        status.textContent = "Network error. Please check your connection and try again.";
        status.className = "text-sm text-red-600";
        submitBtn.disabled = false;
        submitBtn.textContent = original;
      }
    });
  }
</script>
