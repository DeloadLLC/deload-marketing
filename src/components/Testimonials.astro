---
import { API_BASE_URL, testimonials } from "../config";

interface Props {
  heading?: string;
  // When there are no real testimonials yet, show a quiet placeholder instead
  // of fabricating quotes. Set to false to hide the section until quotes load.
  showPlaceholder?: boolean;
}

const { heading = "From coaches in the beta", showPlaceholder = true } = Astro.props;
const hasReal = testimonials.length > 0;
// Coaches submit quotes in the app (Settings) and an admin approves them
// (Admin → Landing quotes); the browser loads the approved ones from the API
// and they replace whatever the page was built with. Quotes are text only:
// no headshots on the marketing site (founder, 2026-11-06).
const apiBase = API_BASE_URL.replace(/\/+$/, "");
---
<section
  class="border-t border-rule py-20 md:py-28"
  data-landing-quotes
  data-api={apiBase}
  hidden={!hasReal && !showPlaceholder}
>
  <div class="wrap grid gap-10 lg:grid-cols-[14rem_1fr] lg:gap-12">
    <h2 class="label pt-2">{heading}</h2>

    <div>
      <ul class:list={["gap-x-10 gap-y-12 md:grid-cols-2", hasReal ? "grid" : "hidden"]} data-quotes-list>
        {testimonials.map((t) => (
          <li>
            <figure>
              <blockquote class="text-[1.5rem] font-medium leading-[1.3] tracking-[-0.015em] text-ink">&ldquo;{t.quote}&rdquo;</blockquote>
              <figcaption class="mt-5 text-[0.9375rem] text-muted">
                <span class="font-medium text-ink">{t.name}</span> · {t.role}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>

      {!hasReal && (
        <div class="max-w-[46rem]" data-quotes-placeholder>
          <p class="h2 text-ink">Real coach stories are on the way.</p>
          <p class="lede mt-5">
            Quotes from the coaches using Deload in the beta will go here. We won't make any up.
          </p>
        </div>
      )}
    </div>
  </div>

  <template data-quote-card>
    <li>
      <figure>
        <blockquote class="text-[1.5rem] font-medium leading-[1.3] tracking-[-0.015em] text-ink" data-quote-text></blockquote>
        <figcaption class="mt-5 text-[0.9375rem] font-medium text-ink" data-quote-name></figcaption>
      </figure>
    </li>
  </template>
</section>

<script>
  interface LandingQuote {
    coachName: string;
    quote: string;
    headshotUrl: string | null;
  }

  async function loadQuotes(section: HTMLElement): Promise<void> {
    const api = section.dataset.api ?? "";
    const list = section.querySelector<HTMLUListElement>("[data-quotes-list]");
    const template = section.querySelector<HTMLTemplateElement>("template[data-quote-card]");
    if (!api || !list || !template) return;
    let quotes: LandingQuote[] = [];
    try {
      const res = await fetch(`${api}/api/landing-quotes`, { headers: { Accept: "application/json" } });
      if (!res.ok) return;
      const body = (await res.json()) as { quotes?: LandingQuote[] };
      quotes = (body.quotes ?? []).filter((q) => q.coachName?.trim() && q.quote?.trim()).slice(0, 4);
    } catch {
      return; // Offline or blocked: keep what the page was built with.
    }
    if (quotes.length === 0) return;

    // Text only: the API's headshotUrl is deliberately not shown here.
    list.replaceChildren(
      ...quotes.map((q) => {
        const card = template.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
        card.querySelector("[data-quote-text]")!.textContent = `“${q.quote.trim()}”`;
        card.querySelector("[data-quote-name]")!.textContent = q.coachName.trim();
        return card;
      }),
    );
    list.classList.replace("hidden", "grid");
    section.querySelector("[data-quotes-placeholder]")?.remove();
    section.hidden = false;
  }

  document.querySelectorAll<HTMLElement>("[data-landing-quotes]").forEach((section) => {
    void loadQuotes(section);
  });
</script>
