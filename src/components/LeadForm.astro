---
import { API_BASE_URL, TURNSTILE_SITE_KEY } from "../config";

interface Props {
  id?: string;
  submitLabel?: string;
  // Demo variant adds an availability field so the team knows when to reach out.
  showAvailability?: boolean;
  // What brings them in — used to tag the message.
  topic?: string;
  // Minimal variant: name + email only, for a low-friction beta sign-up.
  minimal?: boolean;
}

const {
  id = "lead-form",
  submitLabel = "Submit",
  showAvailability = false,
  topic = "lead",
  minimal = false,
} = Astro.props;

const businessTypes = [
  "Individual coach",
  "New business",
  "Single-location studio",
  "Multi-location studio",
  "Migrating from another tool",
  "Other",
];
---
<form
  id={id}
  data-endpoint={`${API_BASE_URL.replace(/\/$/, "")}/api/public/contact`}
  data-turnstile-sitekey={TURNSTILE_SITE_KEY}
  data-topic={topic}
  data-availability={showAvailability ? "1" : ""}
  class="space-y-4 rounded-2xl border border-ink/10 bg-bg p-6 shadow-sm md:p-8"
  novalidate
>
  <div class="grid gap-4 sm:grid-cols-2">
    <label class="block">
      <span class="text-sm font-medium text-ink">Name</span>
      <input type="text" name="name" required maxlength="120"
        class="mt-1.5 block w-full rounded-lg border border-ink/15 bg-bg px-3 py-2.5 text-ink placeholder:text-ink/40 focus:border-ink focus:outline-none"
        placeholder="Your name" />
    </label>
    <label class="block">
      <span class="text-sm font-medium text-ink">Email</span>
      <input type="email" name="email" required maxlength="254"
        class="mt-1.5 block w-full rounded-lg border border-ink/15 bg-bg px-3 py-2.5 text-ink placeholder:text-ink/40 focus:border-ink focus:outline-none"
        placeholder="you@example.com" />
    </label>
  </div>

  {!minimal && (
    <Fragment>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="text-sm font-medium text-ink">Business name <span class="text-ink/40">(optional)</span></span>
          <input type="text" name="business" maxlength="120"
            class="mt-1.5 block w-full rounded-lg border border-ink/15 bg-bg px-3 py-2.5 text-ink placeholder:text-ink/40 focus:border-ink focus:outline-none"
            placeholder="Your gym or studio" />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-ink">What describes you?</span>
          <select name="businessType"
            class="mt-1.5 block w-full rounded-lg border border-ink/15 bg-bg px-3 py-2.5 text-ink focus:border-ink focus:outline-none">
            <option value="">Select…</option>
            {businessTypes.map((t) => <option value={t}>{t}</option>)}
          </select>
        </label>
      </div>

      {showAvailability && (
        <label class="block">
          <span class="text-sm font-medium text-ink">When's a good time to reach you?</span>
          <input type="text" name="availability" maxlength="200"
            class="mt-1.5 block w-full rounded-lg border border-ink/15 bg-bg px-3 py-2.5 text-ink placeholder:text-ink/40 focus:border-ink focus:outline-none"
            placeholder="e.g. weekday mornings ET" />
        </label>
      )}

      <label class="block">
        <span class="text-sm font-medium text-ink">{showAvailability ? "Anything we should know?" : "Tell us a little about yourself"}</span>
        <textarea name="message" rows="4" maxlength="5000"
          class="mt-1.5 block w-full rounded-lg border border-ink/15 bg-bg px-3 py-2.5 text-ink placeholder:text-ink/40 focus:border-ink focus:outline-none"
          placeholder="How many athletes do you coach? What are you using today?"></textarea>
      </label>
    </Fragment>
  )}

  {/* Honeypot — real browsers leave this blank; bots fill it. */}
  <div class="hidden" aria-hidden="true">
    <label>Company name<input type="text" name="companyName" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div id={`${id}-turnstile`} class="cf-turnstile" aria-hidden="true"></div>

  <div class="flex flex-wrap items-center gap-4">
    <button type="submit" id={`${id}-submit`}
      class="rounded-full bg-ink px-6 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-bg transition-colors hover:bg-ink/90 disabled:opacity-60">{submitLabel}</button>
    <p id={`${id}-status`} class="text-sm text-ink/60" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  interface TurnstileApi {
    render: (c: HTMLElement | string, o: Record<string, unknown>) => string;
    getResponse: (id?: string) => string | undefined;
    reset: (id?: string) => void;
    execute: (id?: string) => void;
  }
  interface WindowWithTurnstile extends Window {
    turnstile?: TurnstileApi;
  }
  const w = window as WindowWithTurnstile;

  // Wire up every LeadForm on the page (a page may have more than one).
  const forms = Array.from(document.querySelectorAll<HTMLFormElement>("form[data-endpoint]"));
  for (const form of forms) {
    const id = form.id;
    const submitBtn = document.getElementById(`${id}-submit`) as HTMLButtonElement | null;
    const status = document.getElementById(`${id}-status`);
    const turnstileEl = document.getElementById(`${id}-turnstile`) as HTMLElement | null;
    if (!submitBtn || !status) continue;

    let widgetId: string | undefined;
    const siteKey = (form.dataset.turnstileSitekey || "").trim();
    if (turnstileEl && siteKey) {
      const ensureScript = (): Promise<void> => new Promise((resolve) => {
        if (w.turnstile) { resolve(); return; }
        const existing = document.querySelector('script[data-deload-turnstile="1"]') as HTMLScriptElement | null;
        if (existing) { existing.addEventListener("load", () => resolve(), { once: true }); return; }
        const s = document.createElement("script");
        s.src = "https://challenges.cloudflare.com/turnstile/v0/api.js";
        s.async = true; s.defer = true; s.dataset.deloadTurnstile = "1";
        s.addEventListener("load", () => resolve(), { once: true });
        document.head.appendChild(s);
      });
      ensureScript().then(() => {
        if (!w.turnstile || !turnstileEl) return;
        widgetId = w.turnstile.render(turnstileEl, {
          sitekey: siteKey, size: "invisible", appearance: "interaction-only",
          retry: "auto", "refresh-expired": "auto",
        });
      });
    }

    const endpoint = form.dataset.endpoint || "";
    const topic = form.dataset.topic || "lead";
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      let token = "";
      if (siteKey && w.turnstile) {
        token = w.turnstile.getResponse(widgetId) || "";
        if (!token) {
          try { w.turnstile.execute(widgetId); } catch {}
          const deadline = Date.now() + 6000;
          while (Date.now() < deadline && !token) {
            await new Promise((r) => setTimeout(r, 150));
            token = w.turnstile.getResponse(widgetId) || "";
          }
        }
      }

      const name = String(data.get("name") || "").trim();
      const email = String(data.get("email") || "").trim();
      const business = String(data.get("business") || "").trim();
      const businessType = String(data.get("businessType") || "").trim();
      const availability = String(data.get("availability") || "").trim();
      const note = String(data.get("message") || "").trim();

      if (!name || !email) {
        status.textContent = "Please fill in your name and email.";
        status.className = "text-sm text-red-600";
        return;
      }

      // Compose the richer fields into the message the contact endpoint expects,
      // so the wire payload stays identical to the existing working form.
      const lines = [`[${topic}]`];
      if (business) lines.push(`Business: ${business}`);
      if (businessType) lines.push(`Type: ${businessType}`);
      if (availability) lines.push(`Availability: ${availability}`);
      if (note) lines.push("", note);
      const message = lines.join("\n");

      const payload = {
        name, email,
        roster: businessType,
        message,
        companyName: String(data.get("companyName") || ""),
        turnstileToken: token,
      };

      submitBtn.disabled = true;
      const original = submitBtn.textContent;
      submitBtn.textContent = "Sending…";
      status.textContent = "";
      status.className = "text-sm text-ink/60";
      try {
        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          form.reset();
          status.textContent = "Thanks — we've got it. We'll be in touch soon.";
          status.className = "text-sm text-emerald-700";
        } else {
          let detail = "";
          try { const j = await res.json(); if (j && typeof j.error === "string") detail = j.error; } catch {}
          status.textContent = detail ? `Couldn't send: ${detail}.` : "Couldn't send right now. Please try again.";
          status.className = "text-sm text-red-600";
        }
      } catch {
        status.textContent = "Network error. Please check your connection and try again.";
        status.className = "text-sm text-red-600";
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = original;
      }
    });
  }
</script>
