---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CloseBand from "../components/CloseBand.astro";
import BlockDiagram from "../components/BlockDiagram.astro";
import Arrow from "../components/Arrow.astro";
import { PRIMARY_CTA } from "../config";

const base = import.meta.env.BASE_URL;
const root = base.replace(/\/$/, "");

const diffs = [
  {
    title: "A real programming agent, not autocomplete.",
    body: "Deload writes a complete block for the athlete in front of you: periodization, intensity and intent, built the way a coach would build it.",
  },
  {
    title: "Block-aware, in your voice.",
    body: "Mesocycles, deloads, peaks and tapers that land on the goal date, in your phrasing. Change anything in plain English; you stay the coach of record.",
  },
  {
    title: "The whole job, one app.",
    body: "Programming, import, roster, messaging and the athlete app share one source of truth. Scheduling, billing and reporting are on the way.",
  },
  {
    title: "Built for who general tools skip.",
    body: "Masters athletes, HRT-aware, post-surgical and bone-density-aware programming, for who's actually in front of you.",
  },
];
---

<Layout
  title="Why we're different"
  description="Deload is the first true AI exercise-programming agent — block-aware, written in your voice, and built around the whole coaching job, not a workout tracker with an AI sticker on it."
  hideFooterCta={true}
>
  <PageHero
    title="The first true AI exercise-programming agent."
    intro="Most tools bolted an AI button onto a workout tracker. Deload was built around the programming agent from day one."
  >
    <a href={`${root}/book-a-demo`} class="btn btn-pri btn-lg">Book a demo</a>
    <a href={PRIMARY_CTA.href} class="btn btn-lg">{PRIMARY_CTA.label}</a>
    <a href={`${root}/features/ai-programming`} class="btn btn-quiet btn-lg">See the AI programming <Arrow /></a>
    <BlockDiagram slot="aside" />
  </PageHero>

  <section class="wrap pb-20 md:pb-28">
    {diffs.map((d) => (
      <div class="grid gap-6 border-t border-rule py-12 md:py-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-12">
        <h2 class="h2 text-ink">{d.title}</h2>
        <p class="text-[1.125rem] leading-relaxed text-muted lg:pt-2">{d.body}</p>
      </div>
    ))}
  </section>

  <CloseBand
    title="See it write your first program."
    body="Book a 15-minute demo and we'll write one live."
  >
    <a href={`${root}/book-a-demo`} class="btn btn-pri btn-lg">Book a demo</a>
    <a href={PRIMARY_CTA.href} class="btn btn-lg">{PRIMARY_CTA.label}</a>
  </CloseBand>
</Layout>
