---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CloseBand from "../components/CloseBand.astro";
import BlockDiagram from "../components/BlockDiagram.astro";
import { PRIMARY_CTA } from "../config";

const base = import.meta.env.BASE_URL;
const root = base.replace(/\/$/, "");

const diffs = [
  {
    title: "It drafts the whole block, not one workout.",
    body: "Deload drafts a complete block for the athlete in front of you: periodization, intensity and intent, built the way a coach would build it. You edit it and assign it.",
  },
  {
    title: "Block-aware, in your voice.",
    body: "Mesocycles, deloads, peaks and tapers that land on the goal date, in your phrasing. Change anything in plain English; you stay the coach of record.",
  },
  {
    title: "The whole job, one app.",
    body: "Programming, import, roster, messaging and the athlete app share one source of truth. Scheduling, billing and reporting are on the way.",
  },
  {
    title: "Built for every athlete you coach.",
    body: "Powerlifters, weightlifters, runners, hybrid and masters athletes, each programmed for their level, equipment and injuries.",
  },
];
---

<Layout
  title="Why we're different"
  description="Deload drafts a full, block-aware training program for each athlete in your voice, you edit it in plain English, and it runs the rest of the coaching job in the same app."
  hideFooterCta={true}
>
  <PageHero
    title="Deload drafts the training block. You make the calls."
    intro="It writes a full program for each athlete in your voice, and nothing reaches them until you assign it."
  >
    <a href={PRIMARY_CTA.href} class="btn btn-pri btn-lg">{PRIMARY_CTA.label}</a>
    <a href={`${root}/book-a-demo`} class="btn btn-lg">Book a demo</a>
    <BlockDiagram slot="aside" />
  </PageHero>

  <section class="wrap pb-20 md:pb-28">
    {diffs.map((d) => (
      <div class="grid gap-6 border-t border-rule py-12 md:py-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-12">
        <h2 class="h2 text-ink">{d.title}</h2>
        <p class="text-[1.125rem] leading-relaxed text-muted lg:pt-2">{d.body}</p>
      </div>
    ))}
  </section>

  <CloseBand
    title="See it write your first program."
    body="Book a 15-minute demo and we'll write one live."
  >
    <a href={PRIMARY_CTA.href} class="btn btn-pri btn-lg">{PRIMARY_CTA.label}</a>
    <a href={`${root}/book-a-demo`} class="btn btn-lg">Book a demo</a>
  </CloseBand>
</Layout>
