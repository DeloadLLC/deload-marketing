---
import Layout from "../layouts/Layout.astro";
import { PRIMARY_CTA } from "../config";

const base = import.meta.env.BASE_URL;
const root = base.replace(/\/$/, "");

const diffs = [
  {
    eyebrow: "The engine",
    title: "A real programming agent, not autocomplete.",
    body: "Most “AI” tools pattern-match a workout. Deload writes a complete, block-aware program — periodization, intensity, and intent — for the athlete in front of you. It holds up to a coach's eye because it's built the way a coach would build it, not stitched together from a template.",
  },
  {
    eyebrow: "The craft",
    title: "Block-aware, in your voice.",
    body: "Mesocycles, deloads, peaks, and taper logic that match the goal date — written in the phrasing and cadence you actually use. You preview the plan, edit the structure, and refine in plain English. The agent drafts; you stay the coach of record.",
  },
  {
    eyebrow: "The scope",
    title: "The whole job, one app.",
    body: "Programming, editing, program import, your roster, messaging and the athlete app — sharing one source of truth, with scheduling, billing and reporting on the way. Not a tracker bolted onto a calendar bolted onto an invoicing tool.",
  },
  {
    eyebrow: "The populations",
    title: "Built for who general tools skip.",
    body: "Masters athletes, HRT-aware and post-surgical programming, bone-density-aware work — programmed for who's actually in front of you, not stretched out of a generic template.",
  },
];
---
<Layout
  title="Why we're different"
  description="Deload is the first true AI exercise-programming agent — block-aware, written in your voice, and built around the whole coaching job, not a workout tracker with an AI sticker on it."
>
  <section class="px-6 pt-20 pb-16 md:pt-28">
    <div class="mx-auto max-w-container">
      <p class="text-sm uppercase tracking-[0.18em] text-clay">Why we're different</p>
      <h1 class="mt-4 max-w-4xl text-balance text-4xl font-medium leading-[1.05] tracking-tight text-ink md:text-6xl">
        The first true AI exercise-programming agent.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-ink/70 md:text-xl">
        Plenty of tools bolted an “AI” button onto a workout tracker. Deload was built around the
        programming agent from the start — and it shows in the programs it writes.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={`${root}/book-a-demo`} class="rounded-full bg-ink px-5 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-bg transition-colors hover:bg-ink/90">Book a demo</a>
        <a href={PRIMARY_CTA.href} class="rounded-full border border-ink/20 px-5 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-ink transition-colors hover:bg-ink/5">{PRIMARY_CTA.label}</a>
        <a href={`${root}/features/ai-programming`} class="px-2 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-ink/70 underline-offset-4 transition-colors hover:text-ink hover:underline">See the AI programming</a>
      </div>
    </div>
  </section>

  <section class="border-t border-ink/10">
    <div class="mx-auto max-w-container divide-y divide-ink/10">
      {diffs.map((d) => (
        <div class="grid gap-8 px-6 py-16 md:grid-cols-[1fr_1.4fr] md:py-20">
          <div>
            <p class="text-xs uppercase tracking-[0.18em] text-clay">{d.eyebrow}</p>
            <h2 class="mt-3 text-3xl font-medium tracking-tight text-ink md:text-4xl">{d.title}</h2>
          </div>
          <p class="text-lg leading-relaxed text-ink/75">{d.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-ink/10 px-6 py-24 md:py-28">
    <div class="mx-auto max-w-container text-center">
      <h2 class="mx-auto max-w-2xl text-balance text-3xl font-medium tracking-tight text-ink md:text-5xl">
        See it write your first program.
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-ink/70">Book a 15-minute demo and we'll write one live — or join the waitlist for the private beta.</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href={`${root}/book-a-demo`} class="inline-block rounded-full bg-ink px-6 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-bg transition-colors hover:bg-ink/90">Book a demo</a>
        <a href={PRIMARY_CTA.href} class="inline-block rounded-full border border-ink/20 px-6 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-ink transition-colors hover:bg-ink/5">{PRIMARY_CTA.label}</a>
      </div>
    </div>
  </section>
</Layout>
