---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import BlockDiagram from "../../components/BlockDiagram.astro";
import Arrow from "../../components/Arrow.astro";
import { FEATURES, PRIMARY_CTA, getFeature } from "../../config";

export function getStaticPaths() {
  return FEATURES.map((f) => ({ params: { slug: f.slug } }));
}

const { slug } = Astro.params;
const feature = getFeature(slug!)!;
const base = import.meta.env.BASE_URL;
const root = base.replace(/\/$/, "");

// Related features (same group is overkill here — just show three others).
const others = FEATURES.filter((f) => f.slug !== feature.slug).slice(0, 3);

const flagshipPoints = [
  {
    title: "Built like a coach, not autocomplete",
    body: "Every program is built on real coaching — periodization, intensity, and intent — not set/rep schemes stapled together.",
  },
  {
    title: "Block-aware",
    body: "Mesocycles, deloads, peaks, and taper logic that match the goal date — not a week of random exercises stapled together.",
  },
  {
    title: "You stay the coach",
    body: "Preview the plan, edit the mesostructure, and refine in plain English. The agent drafts; you decide.",
  },
];
---
<Layout title={feature.nav} description={feature.intro}>
  <PageHero label={feature.eyebrow} title={feature.title} intro={feature.intro} soon={feature.status === "soon"}>
    <a href={PRIMARY_CTA.href} class="btn btn-pri btn-lg">{PRIMARY_CTA.label}</a>
    <a href={`${root}/book-a-demo`} class="btn btn-lg">Book a demo</a>
    {feature.flagship && <BlockDiagram slot="aside" />}
  </PageHero>

  {feature.flagship && (
    <section class="wrap pb-6">
      <div class="ink-field rounded-[20px] px-6 py-12 sm:px-10 md:px-14 md:py-16">
        <ul class="grid gap-10 md:grid-cols-3 md:gap-12">
          {flagshipPoints.map((p) => (
            <li>
              <h2 class="text-[1.75rem] font-semibold leading-[1.1] tracking-[-0.03em] text-ink">{p.title}</h2>
              <p class="mt-4 text-muted">{p.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- What you get -->
  <section class="wrap py-20 md:py-24">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] lg:gap-16">
      <div>
        <p class="label">What you get</p>
        <h2 class="h2 mt-4 text-ink">Built for the real job.</h2>
      </div>
      <ul class="rows">
        {feature.points.map((p) => (
          <li class="text-[1.125rem] leading-snug text-ink">{p}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Explore more -->
  <section class="border-t border-rule">
    <div class="wrap py-16 md:py-20">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="label">Explore more</h2>
        <a href={`${root}/features`} class="link-arrow text-[0.9375rem]">See all features <Arrow /></a>
      </div>
      <ul class="mt-6 grid border-t border-rule md:grid-cols-3">
        {others.map((f) => (
          <li class="border-b border-rule md:border-b-0 md:border-r md:last:border-r-0">
            <a href={`${root}/features/${f.slug}`} class="link-arrow group flex h-full flex-col items-start gap-2 py-6 md:px-6 md:first:pl-0">
              <span class="flex flex-wrap items-center gap-2 text-[1.25rem] font-semibold tracking-[-0.02em] text-ink group-hover:text-clay">{f.nav}{f.status === "soon" && <span class="soon">Soon</span>}</span>
              <span class="text-[0.9375rem] font-normal text-muted">{f.menuBlurb}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
