---
import Layout from "../../layouts/Layout.astro";
import { FEATURES, PRIMARY_CTA, getFeature } from "../../config";

export function getStaticPaths() {
  return FEATURES.map((f) => ({ params: { slug: f.slug } }));
}

const { slug } = Astro.params;
const feature = getFeature(slug!)!;
const base = import.meta.env.BASE_URL;
const root = base.replace(/\/$/, "");

// Related features (same group is overkill here — just show three others).
const others = FEATURES.filter((f) => f.slug !== feature.slug).slice(0, 3);
---
<Layout title={feature.nav} description={feature.intro}>
  <!-- Hero -->
  <section class={`px-6 pt-20 pb-16 md:pt-28 ${feature.flagship ? "md:pb-20" : ""}`}>
    <div class="mx-auto max-w-container">
      <div class="flex items-center gap-3">
        <p class="text-sm uppercase tracking-[0.18em] text-clay">{feature.eyebrow}</p>
        {feature.status === "soon" && (
          <span class="rounded-full bg-sage/15 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-sage">Coming soon</span>
        )}
      </div>
      <h1 class="mt-4 max-w-4xl text-balance text-4xl font-medium leading-[1.05] tracking-tight text-ink md:text-6xl">
        {feature.title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-ink/70 md:text-xl">{feature.intro}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={PRIMARY_CTA.href} class="rounded-full bg-ink px-5 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-bg transition-colors hover:bg-ink/90">{PRIMARY_CTA.label}</a>
        <a href={`${root}/book-a-demo`} class="rounded-full border border-ink/20 px-5 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-ink transition-colors hover:bg-ink/5">Book a demo</a>
      </div>
    </div>
  </section>

  {feature.flagship && (
    <section class="border-y border-ink/10 bg-ink/[0.02] px-6 py-16 md:py-20">
      <div class="mx-auto grid max-w-container gap-10 md:grid-cols-3">
        <div>
          <p class="text-3xl font-medium tracking-tight text-ink">Built like a coach, not autocomplete</p>
          <p class="mt-3 text-ink/70">Every program is built on real coaching — periodization, intensity, and intent — not set/rep schemes stapled together.</p>
        </div>
        <div>
          <p class="text-3xl font-medium tracking-tight text-ink">Block-aware</p>
          <p class="mt-3 text-ink/70">Mesocycles, deloads, peaks, and taper logic that match the goal date — not a week of random exercises stapled together.</p>
        </div>
        <div>
          <p class="text-3xl font-medium tracking-tight text-ink">You stay the coach</p>
          <p class="mt-3 text-ink/70">Preview the plan, edit the mesostructure, and refine in plain English. The agent drafts; you decide.</p>
        </div>
      </div>
    </section>
  )}

  <!-- Capability bullets -->
  <section class="px-6 py-20 md:py-24">
    <div class="mx-auto grid max-w-container gap-12 md:grid-cols-[1fr_1.2fr]">
      <div>
        <h2 class="text-sm uppercase tracking-[0.18em] text-clay">What you get</h2>
        <p class="mt-3 text-3xl font-medium tracking-tight text-ink md:text-4xl">Built for the real job.</p>
      </div>
      <ul class="space-y-5 text-lg text-ink/80">
        {feature.points.map((p) => (
          <li class="flex gap-3">
            <span aria-hidden="true" class="mt-2 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-sage" />
            <span>{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Explore more -->
  <section class="border-t border-ink/10 px-6 py-16 md:py-20">
    <div class="mx-auto max-w-container">
      <h2 class="text-sm uppercase tracking-[0.18em] text-clay">Explore more</h2>
      <ul class="mt-6 grid gap-6 md:grid-cols-3">
        {others.map((f) => (
          <li class="rounded-2xl border border-ink/10 bg-bg p-6">
            <a href={`${root}/features/${f.slug}`} class="group block">
              <p class="flex items-center gap-2 text-lg font-medium text-ink group-hover:text-clay">{f.nav}{f.status === "soon" && <span class="rounded-full bg-sage/15 px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-wide text-sage">Soon</span>}</p>
              <p class="mt-2 text-sm text-ink/60">{f.menuBlurb}</p>
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-8">
        <a href={`${root}/features`} class="text-sm font-medium text-ink underline underline-offset-4 hover:text-clay">See all features →</a>
      </div>
    </div>
  </section>
</Layout>
