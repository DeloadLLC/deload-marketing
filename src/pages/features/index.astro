---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Arrow from "../../components/Arrow.astro";
import { FEATURE_GROUPS, PRIMARY_CTA, getFeature } from "../../config";

const base = import.meta.env.BASE_URL;
const root = base.replace(/\/$/, "");
const columns = FEATURE_GROUPS.map((g) => ({
  heading: g.heading,
  items: g.slugs.map((s) => getFeature(s)!).filter(Boolean),
}));
---
<Layout
  title="Features"
  description="AI-assisted programming, plain-English editing, program import, your roster, messaging, the athlete app and a program marketplace — with scheduling, billing and reporting on the way."
>
  <PageHero
    label="Features"
    title="Everything you'd cobble together — in one app, designed like one app."
    intro="Programming, editing, program import, your roster, messaging, the athlete app and a program marketplace — all sharing the same data, so a change in one place doesn't strand the other. Scheduling, billing and reporting are on the way."
    wide
  >
    <a href={PRIMARY_CTA.href} class="btn btn-pri btn-lg">{PRIMARY_CTA.label}</a>
  </PageHero>

  <section class="wrap pb-24">
    {columns.map((col) => (
      <div class="grid gap-4 border-t border-rule py-8 lg:grid-cols-[14rem_1fr] lg:gap-12">
        <h2 class="label pt-1">{col.heading}</h2>
        <ul class="grid gap-x-10 sm:grid-cols-2">
          {col.items.map((f) => (
            <li>
              <a href={`${root}/features/${f.slug}`} class="group block py-3">
                <span class="flex flex-wrap items-center gap-2 text-[1.25rem] font-semibold tracking-[-0.02em] text-ink transition-colors group-hover:text-clay">
                  {f.nav}
                  {f.status === "soon" && <span class="soon">Soon</span>}
                  <Arrow class="opacity-0 transition-opacity group-hover:opacity-100" />
                </span>
                <span class="mt-1 block text-[0.9375rem] leading-snug text-muted">{f.menuBlurb}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</Layout>
