---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import { FEATURE_GROUPS, PRIMARY_CTA, getFeature, isLiveFeature } from "../../config";

const base = import.meta.env.BASE_URL;
const root = base.replace(/\/$/, "");
// Live features only; pages marked "Coming soon" stay unlinked (founder, 2026-11-12).
const columns = FEATURE_GROUPS.map((g) => ({
  heading: g.heading,
  items: g.slugs.map((s) => getFeature(s)!).filter((f) => Boolean(f) && isLiveFeature(f)),
})).filter((c) => c.items.length > 0);
---
<Layout
  title="Features"
  description="AI-assisted programming, plain-English editing, program import, your roster, messaging, the athlete app and a program marketplace, with scheduling, billing and reporting on the way."
>
  <PageHero
    title="Everything you'd cobble together, in one app."
    intro="Programming, import, roster, messaging, the athlete app and a program marketplace, on the same data. Scheduling, billing and reporting are on the way."
    wide
  >
    <a href={PRIMARY_CTA.href} class="btn btn-pri btn-lg">{PRIMARY_CTA.label}</a>
  </PageHero>

  <section class="wrap pb-24">
    {columns.map((col) => (
      <div class="grid gap-4 border-t border-rule py-8 lg:grid-cols-[14rem_1fr] lg:gap-12">
        <h2 class="label pt-1">{col.heading}</h2>
        <ul class="grid gap-x-10 sm:grid-cols-2">
          {col.items.map((f) => (
            <li>
              <a href={`${root}/features/${f.slug}`} class="group block py-3">
                <span class="block text-[1.25rem] font-semibold tracking-[-0.02em] text-ink transition-colors group-hover:text-clay">{f.nav}</span>
                <span class="mt-1 block text-[0.9375rem] leading-snug text-muted">{f.menuBlurb}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</Layout>
