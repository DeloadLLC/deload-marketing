---
import Layout from "../layouts/Layout.astro";
import LeadForm from "../components/LeadForm.astro";
import Testimonials from "../components/Testimonials.astro";
import PageHero from "../components/PageHero.astro";
import { PRIMARY_CTA } from "../config";

const seeItems = [
  "Your first program, written live in front of you.",
  "A block changed in plain English, with every change spelled out.",
  "Your roster, your messages and your athletes' training, in one place.",
  "Your programs imported from Excel, Word or PDF, and a plan to move your athletes.",
];
---
<Layout
  title="Book a demo"
  description="See Deload on your own roster. Book a demo and see what Deload takes off your week — programming, your roster and the athlete app — and ask anything about moving over from your current tool."
>
  <PageHero title="See it on your own roster." wide>
    <p slot="after-intro" class="lede mt-6">
      We'll show you what Deload takes off your week and how to bring your programs over. Rather wait for an invite?
      <a href={PRIMARY_CTA.href} class="link">Join the waitlist.</a>
    </p>
  </PageHero>

  <section class="wrap pb-20 md:pb-24">
    <div class="grid gap-12 border-t border-rule pt-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16">
      <div>
        <h2 class="h3 text-[1.75rem] text-ink">What you'll see</h2>
        <ul class="rows mt-6">
          {seeItems.map((t) => <li class="text-[1.0625rem] text-ink">{t}</li>)}
        </ul>
      </div>
      <div>
        <LeadForm id="demo-form" submitLabel="Request my demo" topic="demo" showAvailability={true} />
      </div>
    </div>
  </section>

  <Testimonials heading="What coaches are saying" />
</Layout>
