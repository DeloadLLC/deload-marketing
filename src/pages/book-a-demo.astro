---
import Layout from "../layouts/Layout.astro";
import LeadForm from "../components/LeadForm.astro";
import Testimonials from "../components/Testimonials.astro";
import { PRIMARY_CTA, SIGNUP_COPY } from "../config";

const seeItems = [
  "Your first program, written live in front of you.",
  "A block changed in plain English, with every change spelled out.",
  "Your roster, your messages and your athletes' training, in one place.",
  "Your programs imported from Excel, Word or PDF, and a plan to move your athletes.",
];
---
<Layout
  title="Book a demo"
  description="See Deload on your own roster. Book a demo and see what Deload takes off your week (programming, your roster and the athlete app) and ask anything about moving over from your current tool."
>
  <!-- The form sits beside the headline so it starts above the fold on a
       1280x800 laptop; on phones it follows the intro (founder, 2026-11-12). -->
  <section class="wrap pt-14 pb-20 md:pt-20 md:pb-24">
    <div class="grid items-start gap-12 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:gap-16">
      <div>
        <h1 class="display-sm max-w-[16ch] text-ink">See it on your own roster.</h1>
        <p class="lede mt-6">
          We'll show you what Deload takes off your week and how to bring your programs over. {SIGNUP_COPY.demoAlternative.lead}
          <a href={PRIMARY_CTA.href} class="link">{SIGNUP_COPY.demoAlternative.link}</a>
        </p>
        <h2 class="h3 mt-10 text-ink">What you'll see</h2>
        <ul class="rows mt-5">
          {seeItems.map((t) => <li class="text-[1.0625rem] text-ink">{t}</li>)}
        </ul>
      </div>
      <div>
        <LeadForm id="demo-form" submitLabel="Request my demo" topic="demo" showAvailability={true} />
      </div>
    </div>
  </section>

  <Testimonials heading="What coaches are saying" />
</Layout>
