---
import Layout from "../layouts/Layout.astro";
import LeadForm from "../components/LeadForm.astro";
import Testimonials from "../components/Testimonials.astro";
import PageHero from "../components/PageHero.astro";
import { PRIMARY_CTA } from "../config";

const seeItems = [
  "A program written live from a plain-English brief — block by block, in front of you.",
  "Plain-English edits rippling through a block, with before/after diffs.",
  "Your roster, in-app messaging, and the app your athletes train from.",
  "Your existing programs imported from Excel, Word or PDF — and a plan for moving your athletes over.",
];
---
<Layout
  title="Book a demo"
  description="See Deload on your own roster. Book a walkthrough and we'll show you AI-assisted programming, plain-English editing, and the athlete app — and answer anything about moving over from your current tool."
>
  <PageHero label="Book a demo" title="See it on your own roster." wide>
    <p slot="after-intro" class="lede mt-6">
      We'll walk you through AI-assisted programming, plain-English editing, your roster, and the athlete app
      &mdash; and talk through bringing your programs over from a spreadsheet or another tool. Rather wait for an invite?
      <a href={PRIMARY_CTA.href} class="link">Join the waitlist.</a>
    </p>
  </PageHero>

  <section class="wrap pb-20 md:pb-24">
    <div class="grid gap-12 border-t border-rule pt-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16">
      <div>
        <h2 class="h3 text-[1.75rem] text-ink">What you'll see</h2>
        <ul class="rows mt-6">
          {seeItems.map((t) => <li class="text-[1.0625rem] text-ink">{t}</li>)}
        </ul>
      </div>
      <div>
        <LeadForm id="demo-form" submitLabel="Request my demo" topic="demo" showAvailability={true} />
      </div>
    </div>
  </section>

  <Testimonials heading="What coaches are saying" />
</Layout>
