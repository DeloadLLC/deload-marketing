---
import Layout from "../layouts/Layout.astro";
import LeadForm from "../components/LeadForm.astro";
import Testimonials from "../components/Testimonials.astro";
import { PRIMARY_CTA } from "../config";
---
<Layout
  title="Book a demo"
  description="See Deload on your own roster. Book a walkthrough and we'll show you AI-assisted programming, plain-English editing, and the athlete app — and answer anything about moving over from your current tool."
>
  <section class="px-6 pt-20 pb-12 md:pt-28">
    <div class="mx-auto max-w-container">
      <p class="text-sm uppercase tracking-[0.18em] text-ink/50">Book a demo</p>
      <h1 class="mt-4 max-w-3xl text-balance text-4xl font-medium leading-[1.1] tracking-tight md:text-5xl">
        See it on your own roster.
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-ink/70">
        We'll walk you through AI-assisted programming, plain-English editing, your roster, and the athlete app
        &mdash; and talk through bringing your programs over from a spreadsheet or another tool. Rather wait for an invite?
        <a href={PRIMARY_CTA.href} class="font-medium text-ink underline underline-offset-4 hover:text-clay">Join the waitlist.</a>
      </p>
    </div>
  </section>

  <section class="px-6 pb-8">
    <div class="mx-auto grid max-w-container gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div>
        <h2 class="text-2xl font-medium tracking-tight text-ink">What you'll see</h2>
        <ul class="mt-6 space-y-4 text-ink/80">
          <li class="flex gap-3"><span aria-hidden="true" class="mt-2 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-sage" /><span>A program written live from a plain-English brief — block by block, in front of you.</span></li>
          <li class="flex gap-3"><span aria-hidden="true" class="mt-2 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-sage" /><span>Plain-English edits rippling through a block, with before/after diffs.</span></li>
          <li class="flex gap-3"><span aria-hidden="true" class="mt-2 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-sage" /><span>Your roster, in-app messaging, and the app your athletes train from.</span></li>
          <li class="flex gap-3"><span aria-hidden="true" class="mt-2 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-sage" /><span>Your existing programs imported from Excel, Word or PDF &mdash; and a plan for moving your athletes over.</span></li>
        </ul>
      </div>
      <div>
        <LeadForm id="demo-form" submitLabel="Request my demo" topic="demo" showAvailability={true} />
      </div>
    </div>
  </section>

  <Testimonials heading="What coaches are saying" />
</Layout>
