---
// The legal pages live in the app (one copy, kept current with the beta
// decisions); this address forwards there so old links keep working.
import { TERMS_URL } from "../config";
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Terms — Deload</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={TERMS_URL} />
    <meta http-equiv="refresh" content={`0; url=${TERMS_URL}`} />
  </head>
  <body style="font-family: system-ui, sans-serif; padding: 2rem;">
    <p>Deload's Terms page has moved to <a href={TERMS_URL}>{TERMS_URL}</a>.</p>
  </body>
</html>
