---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { API_BASE_URL, TURNSTILE_SITE_KEY } from "../config";
---
<Layout
  title="Contact"
  description="Questions, feedback, or a feature in mind? Send us a note."
>
  <PageHero
    title="Tell us about your roster."
    intro="Questions, or a feature in mind? Drop us a line."
  />

  <section class="wrap pb-24">
    <div class="max-w-2xl">
      <form
        id="contact-form"
        data-endpoint={`${API_BASE_URL.replace(/\/$/, "")}/api/public/contact`}
        data-turnstile-sitekey={TURNSTILE_SITE_KEY}
        class="space-y-5 rounded-[20px] border border-rule bg-surface p-6 md:p-8"
        novalidate
      >
        <div class="grid gap-5 md:grid-cols-2">
          <label class="block">
            <span class="text-sm font-medium text-ink">Name</span>
            <input
              type="text"
              name="name"
              required
              maxlength="120"
              class="field-input"
              placeholder="Your name"
            />
          </label>
          <label class="block">
            <span class="text-sm font-medium text-ink">Email</span>
            <input
              type="email"
              name="email"
              required
              maxlength="254"
              class="field-input"
              placeholder="you@example.com"
            />
          </label>
        </div>
        <label class="block">
          <span class="text-sm font-medium text-ink">Roster size (optional)</span>
          <input
            type="text"
            name="roster"
            maxlength="120"
            class="field-input"
            placeholder="e.g. 14 athletes"
          />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-ink">Message</span>
          <textarea
            name="message"
            rows="5"
            required
            maxlength="5000"
            class="field-input"
            placeholder="What's on your mind?"
          ></textarea>
        </label>

        {/* Honeypot — real browsers leave this blank; bots fill it. Hidden from
            humans and screen readers via aria-hidden + tabindex. */}
        <div class="hidden" aria-hidden="true">
          <label>
            Company name
            <input
              type="text"
              name="companyName"
              tabindex="-1"
              autocomplete="off"
            />
          </label>
        </div>

        {/* Cloudflare Turnstile invisible/managed widget. The script
            mounts it here and we read its token via turnstile.getResponse
            before submit. Rendered only when a site key is configured;
            otherwise the form still submits and the server falls back to
            honeypot + per-IP rate limit (Task #1877). */}
        <div id="contact-turnstile" class="cf-turnstile" aria-hidden="true"></div>

        <div class="flex flex-wrap items-center gap-4">
          <button
            type="submit"
            id="contact-submit"
            class="btn btn-pri btn-lg"
          >Send</button>
          <p
            id="contact-status"
            class="text-sm text-muted"
            role="status"
            aria-live="polite"
          ></p>
        </div>
      </form>
    </div>
  </section>

  <script>
    interface TurnstileApi {
      render: (
        container: HTMLElement | string,
        options: {
          sitekey: string;
          size?: "invisible" | "compact" | "normal" | "flexible";
          appearance?: "always" | "execute" | "interaction-only";
          retry?: "auto" | "never";
          "refresh-expired"?: "auto" | "manual" | "never";
        },
      ) => string;
      getResponse: (widgetId?: string) => string | undefined;
      reset: (widgetId?: string) => void;
      execute: (widgetId?: string) => void;
    }
    interface WindowWithTurnstile extends Window {
      turnstile?: TurnstileApi;
    }
    const w = window as WindowWithTurnstile;

    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const submitBtn = document.getElementById("contact-submit") as HTMLButtonElement | null;
    const status = document.getElementById("contact-status");
    const turnstileEl = document.getElementById("contact-turnstile") as HTMLElement | null;

    // Mount the Turnstile widget (invisible/managed) when a site key is
    // configured. We load the script lazily so pages without a key
    // never hit Cloudflare. Task #1877.
    let turnstileWidgetId: string | undefined;
    const turnstileSiteKey = (form?.dataset.turnstileSitekey || "").trim();
    if (form && turnstileEl && turnstileSiteKey) {
      const ensureScript = (): Promise<void> => new Promise((resolve) => {
        if (w.turnstile) { resolve(); return; }
        const existing = document.querySelector(
          'script[data-deload-turnstile="1"]',
        ) as HTMLScriptElement | null;
        if (existing) {
          existing.addEventListener("load", () => resolve(), { once: true });
          return;
        }
        const s = document.createElement("script");
        s.src = "https://challenges.cloudflare.com/turnstile/v0/api.js";
        s.async = true;
        s.defer = true;
        s.dataset.deloadTurnstile = "1";
        s.addEventListener("load", () => resolve(), { once: true });
        document.head.appendChild(s);
      });
      ensureScript().then(() => {
        if (!w.turnstile) return;
        turnstileWidgetId = w.turnstile.render(turnstileEl, {
          sitekey: turnstileSiteKey,
          size: "invisible",
          appearance: "interaction-only",
          retry: "auto",
          "refresh-expired": "auto",
        });
      });
    }

    if (form && submitBtn && status) {
      const endpoint = form.dataset.endpoint || "";
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const data = new FormData(form);
        let turnstileToken = "";
        if (turnstileSiteKey && w.turnstile) {
          turnstileToken = w.turnstile.getResponse(turnstileWidgetId) || "";
          if (!turnstileToken) {
            // Force the invisible challenge to run, then read again.
            try { w.turnstile.execute(turnstileWidgetId); } catch {}
            // Poll briefly for completion (managed widgets resolve fast).
            const deadline = Date.now() + 6000;
            while (Date.now() < deadline && !turnstileToken) {
              await new Promise((r) => setTimeout(r, 150));
              turnstileToken = w.turnstile.getResponse(turnstileWidgetId) || "";
            }
          }
        }
        const payload = {
          name: String(data.get("name") || ""),
          email: String(data.get("email") || ""),
          roster: String(data.get("roster") || ""),
          message: String(data.get("message") || ""),
          companyName: String(data.get("companyName") || ""),
          turnstileToken,
        };
        if (!payload.name.trim() || !payload.email.trim() || !payload.message.trim()) {
          status.textContent = "Please fill in your name, email, and a message.";
          status.className = "text-sm text-warn";
          return;
        }
        submitBtn.disabled = true;
        const originalLabel = submitBtn.textContent;
        submitBtn.textContent = "Sending\u2026";
        status.textContent = "";
        status.className = "text-sm text-muted";
        try {
          const res = await fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          if (res.ok) {
            form.reset();
            status.textContent = "Thanks, your message is in. We'll be in touch soon.";
            status.className = "text-sm text-emerald-700";
          } else {
            let detail = "";
            try {
              const json = await res.json();
              if (json && typeof json.error === "string") detail = json.error;
            } catch {}
            status.textContent = detail
              ? `Couldn't send: ${detail}. Please try again.`
              : "Couldn't send right now. Please try again in a moment.";
            status.className = "text-sm text-warn";
          }
        } catch {
          status.textContent = "Network error. Please check your connection and try again.";
          status.className = "text-sm text-warn";
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = originalLabel;
        }
      });
    }
  </script>
</Layout>
