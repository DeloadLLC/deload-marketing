---
import Layout from "../layouts/Layout.astro";
import Shot from "../components/Shot.astro";
import Testimonials from "../components/Testimonials.astro";
import { OFFER_LINE, PRIMARY_CTA, SITE_DESCRIPTION } from "../config";

// Home as one story (founder-approved copy, 15 Nov 2026; spec:
// docs/superpowers/specs/2026-11-15-home-story-design.md): the opening, the
// coach's week, time back, clients who stay, room to grow, the founder, and
// one closing action. The copy is the founder's, word for word, and every
// claim is live on production. Every action goes to the primary call to
// action (sign-up, or the waitlist while sign-up is by invitation).

const root = import.meta.env.BASE_URL.replace(/\/$/, "");

// Act 3's supporting lines. The timing is measured on staging (10 programs,
// median 3.0 min, slowest 3.6 min; founder approved, 15 Nov). The time for a
// whole program stays off the page until "Build the rest" is fixed.
const timeBack = [
  "Your first week is ready to edit in under 4 minutes.",
  "Strength, muscle, sport, endurance and older athletes.",
  "RPE, RIR and percentages, the way you already use them.",
  "Move a day or swap a lift, and it sorts out the weeks that follow.",
  "Every change is saved, and you can undo any of it.",
  "Already have programs? Bring them in from Excel, Word or PDF.",
];

// The athlete's side: three screens of one app, light and dark.
const athleteShots = [
  { name: "athlete-today", alt: "The athlete's Today screen: a deadlift session with its warm-up, main lifts and cool-down.", caption: "Today's workout, warm-up to cool-down." },
  { name: "athlete-history", alt: "The athlete's History screen: past sessions with their sets, and estimated maxes per lift.", caption: "Every session they've logged, and how far they've come." },
  { name: "athlete-messages", alt: "The athlete's inbox: a note to the coach about the deadlifts and the coach's reply.", caption: "You, one tap away." },
];
---
<Layout title="deload" description={SITE_DESCRIPTION} hideFooterCta={true}>
  <!-- 1. Opening: the head and the action on five columns, the program
       calendar on six. -->
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-text">
      <h1 id="hero-title" class="hero-head text-ink">You got into this to coach. Not to spend your nights writing programs and answering texts.</h1>
      <p class="lede mt-6">Deload writes the first draft of every program, keeps your athletes on track between sessions, and gives your whole team one place to work. You get your evenings back, and your clients stick around.</p>
      <div class="mt-8">
        <a href={PRIMARY_CTA.href} class="btn btn-pri btn-lg">{PRIMARY_CTA.label}</a>
      </div>
      <p class="mt-4 text-[0.9375rem] text-muted">{OFFER_LINE}</p>
    </div>
    <figure class="hero-shot">
      <!-- Cropped to the calendar itself: the week checks in the side panel
           are behind a beta switch, so they stay out of the frame. -->
      <Shot
        name="coach-calendar"
        dark
        width={2880}
        height={1800}
        alt="A 4-week squat and deadlift block on the Deload program calendar: four training days a week with sets, reps, percentages and RPE."
        ratio="2140 / 1600"
        zoom={1.346}
        ratioSm="1 / 1"
        zoomSm={2.4}
        eager
      />
      <figcaption class="sr-only">Demo data from the Deload coach app.</figcaption>
    </figure>
  </section>

  <!-- 2. Their week: the problem, and the founder's first note -->
  <section class="sec border-t border-rule" aria-labelledby="week-title">
    <div class="wrap">
      <div class="head-split">
        <h2 id="week-title" class="h2 text-ink">Sound familiar?</h2>
        <p class="lede">Sunday night, you're writing next week's programs. Monday, you're answering the same texts you answered last week. Somewhere in between, a client stops showing up and you don't notice until they've gone. You're good at coaching. It's everything around it that wears you down.</p>
      </div>
      <figure class="note mt-12 md:mt-16">
        <blockquote class="note-quote text-ink"><p>&ldquo;For years I wrote programs at 11pm and rewrote them by 7am. I built Deload so I'd stop.&rdquo;</p></blockquote>
        <figcaption class="note-by">— Derek</figcaption>
      </figure>
    </div>
  </section>

  <!-- 3. Time back: describing the athlete, then the plan and the lines -->
  <section class="sec-l border-t border-rule" aria-labelledby="time-title">
    <div class="wrap">
      <div class="head-split">
        <h2 id="time-title" class="h2 text-ink">Your programs, drafted for you.</h2>
        <p class="lede">Tell Deload about your athlete the way you'd tell another coach: what they're training for, how many days they have, what equipment they've got, what hurts. It writes the whole program in your style. You read it, change what you'd change, and send it. Nothing reaches your athlete until you say so.</p>
      </div>
      <figure class="mt-12 md:mt-16">
        <Shot
          name="coach-generate-brief"
          dark
          width={2880}
          height={1800}
          alt="Deload's Generate screen: a description of the athlete for a 4-week strength program, with the weeks, days, length, equipment and a left-knee caution picked out of it."
          ratioSm="4 / 3"
          zoomSm={1.9}
          fx={0.62}
          shiftYSm={0.06}
        />
      </figure>
      <div class="plan mt-12 md:mt-16">
        <ul class="lines">
          {timeBack.map((line) => <li class="text-ink">{line}</li>)}
        </ul>
        <figure class="plan-shot">
          <Shot
            name="coach-generate-plan"
            dark
            width={2880}
            height={1800}
            alt="Before it writes, Deload says what it will check the program against, with the buttons to go ahead or change it."
            ratio="360 / 520"
            zoom={4}
            fx={1}
            shiftY={0.1}
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- 4. They stay: the athlete's side, three screens of one app -->
  <section class="sec-l field" aria-labelledby="stay-title">
    <div class="wrap">
      <div class="head-split">
        <h2 id="stay-title" class="h2 text-ink">Clients who feel coached stay.</h2>
        <p class="lede">Your athletes open Deload on their phone and see today's workout with the weights already worked out. They log as they go, even with no signal in the gym. They can see themselves getting stronger, and they can message you right next to the workout. It's free for them, with nothing to install.</p>
      </div>
      <ul class="phones mt-12 md:mt-16">
        {athleteShots.map((s) => (
          <li>
            <figure>
              <Shot name={s.name} dark width={780} height={1688} alt={s.alt} ratio="390 / 600" ratioSm="390 / 560" />
              <figcaption class="cap">{s.caption}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. Room to grow: the team, selling programs, what it replaces, what's
       on the way. Teams share the roster and the business's exercise library
       on production; "the same programs" waits for the team program library
       to be on for every team. -->
  <section class="sec-l" aria-labelledby="grow-title">
    <div class="wrap">
      <div class="head-split">
        <h2 id="grow-title" class="h2 text-ink">Room to grow.</h2>
        <p class="lede">Bring on another coach and they work from the same exercise library you do, so every client gets your standard. Share clients across the team when it helps. And sell your best programs to people you've never met, paid straight into your own Stripe account.</p>
      </div>
      <figure class="mt-12 md:mt-16">
        <Shot
          name="coach-team-roster"
          dark
          width={2880}
          height={1800}
          alt="A coaching team's shared roster in Deload: athletes with their coach and this week's training."
          ratioSm="4 / 3"
          zoomSm={2.4}
          fx={0.2}
          shiftYSm={0.12}
        />
      </figure>
      <div class="grow-foot mt-12 md:mt-16">
        <div class="replaces" data-reveal>
          <p class="label">What it replaces</p>
          <p class="replaces-line text-ink">Your <span class="strike">programming spreadsheet</span>, the <span class="strike">PDFs you send</span>, the <span class="strike">group chat</span>, and the <span class="strike">storefront</span> you sell programs from.</p>
          <p class="mt-6 text-[0.9375rem] text-muted">Booking, billing your clients and intake forms are on the way.</p>
        </div>
        <figure class="note">
          <blockquote class="note-quote text-ink"><p>&ldquo;Coach burnout is real. If Deload takes some of that weight off and helps your business grow, it was worth building.&rdquo;</p></blockquote>
          <figcaption class="note-by">— Derek</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 6. Why Deload: the quote as a statement, the story beneath -->
  <section class="sec border-t border-rule" aria-labelledby="founder-title">
    <div class="wrap">
      <h2 id="founder-title" class="display founder-quote text-ink">&ldquo;I built Deload because I needed it.&rdquo;</h2>
      <div class="founder mt-10 md:mt-14">
        <p class="text-[0.9375rem] text-muted">— Derek Miranda, founder</p>
        <div class="space-y-5 text-[1.0625rem] text-muted">
          <p>I coached at Equinox, then on my own with Sportslab NYC and Fitness360NYC, from weight-loss clients to marathoners and powerlifters.</p>
          <p>I tried using AI for my own programming, and it worked. Turning that draft into something you can actually run on the gym floor took an enormous amount of work. That work is Deload.</p>
          <a href={`${root}/about`} class="link inline-flex min-h-[44px] items-center">Read the full story</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Coach quotes: only real, approved ones; the section stays hidden until
       the API returns some. -->
  <Testimonials showPlaceholder={false} />

  <!-- 7. Close: the one action again -->
  <section class="wrap pb-16 md:pb-24" aria-labelledby="close-title">
    <div class="ink-field close">
      <h2 id="close-title" class="display text-ink">Get your Sunday back.</h2>
      <div class="close-act">
        <p class="max-w-[40ch] text-[1.0625rem] text-muted">{OFFER_LINE}</p>
        <a href={PRIMARY_CTA.href} class="btn btn-pri btn-lg">{PRIMARY_CTA.label}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Opening: fills the first screen under the 64px header on wide screens;
     collapses to its content's height below 60rem. The headline is two
     sentences, so it sets a notch under the old two-line hero and balances
     its lines (no word left alone on the last one). */
  .hero {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-xl) var(--space-2xl);
  }
  .hero-shot { margin: 0; min-width: 0; }
  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
      gap: var(--space-xl) var(--space-2xl);
      min-height: calc(100svh - 4rem);
      padding-block: var(--space-xl);
    }
  }
  .hero-head {
    font-size: clamp(2.25rem, 1.5rem + 2.2vw, 3.25rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    font-weight: 600;
    max-width: 16ch;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  /* Section rhythm: two steps, mixed. */
  .sec { padding-block: var(--section-gap-s); }
  .sec-l { padding-block: var(--section-gap); }

  /* A head and its line, split across the row on wide screens. */
  .head-split { display: grid; gap: var(--space-md); }
  .head-split .h2 { max-width: 18ch; }
  @media (min-width: 60rem) {
    .head-split {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-2xl);
      align-items: start;
    }
  }

  .cap {
    margin-top: var(--space-sm);
    max-width: 60ch;
    font-size: 0.9375rem;
    color: rgb(var(--c-muted));
  }

  /* The founder's notes: the pull quote, a size down, signed. On wide
     screens they sit on the right seven columns, under the section's line. */
  .note { margin: 0; display: grid; gap: var(--space-sm); }
  .note-quote {
    margin: 0;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.125rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 600;
    max-width: 30ch;
    text-wrap: balance;
  }
  .note-by { font-size: 0.9375rem; color: rgb(var(--c-muted)); }
  @media (min-width: 60rem) {
    .sec > .wrap > .note { margin-left: calc((100% - var(--space-2xl)) * 5 / 12 + var(--space-2xl)); }
  }

  /* Time back: the lines as hairline rows beside the plan panel. */
  .plan { display: grid; gap: var(--space-xl); }
  .plan-shot { margin: 0; min-width: 0; width: 100%; max-width: 28rem; justify-self: center; }
  @media (min-width: 60rem) {
    .plan {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: var(--space-2xl);
      align-items: center;
    }
    .plan-shot { max-width: 30rem; justify-self: end; }
  }
  .lines { border-top: 1px solid rgb(var(--c-rule)); }
  .lines li {
    padding-block: var(--space-md);
    border-bottom: 1px solid rgb(var(--c-rule));
    font-size: 1.125rem;
    line-height: 1.45;
  }
  .lines li:first-child { font-weight: 600; }

  /* Three phones across; a scrollable rail would hide two of three on a
     phone, so they stack. */
  .phones { display: grid; gap: var(--space-xl); }
  @media (min-width: 48rem) {
    .phones { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap-columns); }
  }
  .phones figure { margin: 0; }
  .phones .cap { color: rgb(var(--c-muted)); }

  /* Room to grow: what it replaces (old tools struck in clay) beside the
     founder's note. */
  .grow-foot { display: grid; gap: var(--space-2xl); border-top: 1px solid rgb(var(--c-rule)); padding-top: var(--space-lg); }
  .replaces .label { margin-bottom: var(--space-sm); }
  .replaces-line {
    font-size: clamp(1.375rem, 1.1rem + 0.9vw, 1.75rem);
    line-height: 1.35;
    letter-spacing: -0.02em;
    font-weight: 500;
    max-width: 34ch;
  }
  @media (min-width: 60rem) {
    .grow-foot { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-2xl); }
  }

  .founder-quote { max-width: 18ch; }
  .founder { display: grid; gap: var(--space-md); border-top: 1px solid rgb(var(--c-rule)); padding-top: var(--space-lg); }
  @media (min-width: 60rem) {
    .founder { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-2xl); }
    .founder .space-y-5 { max-width: 52ch; }
  }

  .close {
    display: grid;
    gap: var(--space-xl);
    border-radius: var(--radius-band);
    padding: var(--space-3xl) var(--space-lg) var(--space-xl);
  }
  @media (min-width: 40rem) { .close { padding-inline: var(--space-xl); } }
  @media (min-width: 60rem) {
    .close {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      padding: var(--space-3xl) var(--space-2xl) var(--space-2xl);
    }
  }
  .close-act { display: grid; gap: var(--space-lg); justify-items: start; }
</style>
