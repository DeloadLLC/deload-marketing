---
import Layout from "../layouts/Layout.astro";
import Testimonials from "../components/Testimonials.astro";
import { PRIMARY_CTA, absorbed, proofPoints, pillars, SITE_DESCRIPTION } from "../config";

const description = SITE_DESCRIPTION;
const root = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<Layout title="deload" description={description}>
  <!-- Hero -->
  <section class="px-6 pt-20 pb-24 md:pt-28 md:pb-32">
    <div class="mx-auto max-w-container">
      <p class="mb-6 text-sm uppercase tracking-[0.18em] text-ink/50">
        The all-in-one AI coaching platform
      </p>
      <h1 class="max-w-3xl text-4xl font-medium leading-[1.05] tracking-tight text-ink md:text-6xl">
        Give your <span class="inline-grid text-sage">
          <span class="invisible col-start-1 row-start-1" aria-hidden="true">athletes</span>
          <span class="invisible col-start-1 row-start-1" aria-hidden="true">patients</span>
          <span class="invisible col-start-1 row-start-1" aria-hidden="true">clients</span>
          <span
            id="hero-noun"
            data-nouns="athletes,clients,patients"
            class="col-start-1 row-start-1"
          >athletes</span>
        </span> the program they deserve &mdash; without losing your Sunday night.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-ink/70 md:text-xl">
        Deload writes block-aware training in your voice, edits with you in plain English, runs your roster, and ships the program straight to your athletes' phones &mdash; so you can keep the relationship and skip the spreadsheet.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={`${root}/book-a-demo`}
          class="inline-block rounded-full bg-ink px-5 py-3 text-sm font-medium text-bg transition-colors hover:bg-ink/90"
        >Book a demo</a>
        <a
          href={PRIMARY_CTA.href}
          class="inline-block rounded-full border border-ink/15 px-5 py-3 text-sm font-medium text-ink transition-colors hover:bg-ink/5"
        >{PRIMARY_CTA.label}</a>
        <a
          href={`${root}/why`}
          class="inline-block px-2 py-3 text-sm font-medium text-ink/70 underline-offset-4 transition-colors hover:text-ink hover:underline"
        >Why we're different</a>
      </div>
      <p class="mt-5 text-sm text-ink/50">
        Book a 15-minute demo &middot; or join the waitlist for the private beta
      </p>
    </div>
  </section>

  <!-- Three pillars: Build / Run / Ship -->
  <section class="border-t border-ink/10 px-6 py-20 md:py-28">
    <div class="mx-auto max-w-container">
      <div class="mb-12 max-w-2xl">
        <h2 class="text-sm uppercase tracking-[0.18em] text-clay">
          One app, the whole job
        </h2>
        <p class="mt-3 text-3xl font-medium tracking-tight text-ink md:text-4xl">
          Programming, roster, athlete app &mdash; in the same window.
        </p>
      </div>
      <ul class="grid gap-6 md:grid-cols-3">
        {pillars.map((p) => (
          <li class="rounded-2xl border border-ink/10 bg-bg p-7 md:p-8">
            <p class="text-xs uppercase tracking-[0.16em] text-sage">{p.eyebrow}</p>
            <p class="mt-3 text-xl font-medium tracking-tight text-ink">{p.title}</p>
            <p class="mt-3 text-ink/70">{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- What this absorbs -->
  <section class="border-t border-ink/10 px-6 py-20 md:py-28">
    <div class="mx-auto max-w-container">
      <div class="mb-12 max-w-2xl">
        <h2 class="text-sm uppercase tracking-[0.18em] text-clay">
          What this absorbs for you
        </h2>
        <p class="mt-3 text-3xl font-medium tracking-tight text-ink md:text-4xl">
          The hours that don't show up on a roster.
        </p>
      </div>
      <ul class="grid gap-6 md:grid-cols-2">
        {absorbed.map((item) => (
          <li class="rounded-2xl border border-ink/10 bg-bg p-7 md:p-8">
            <p class="text-xs uppercase tracking-[0.16em] text-sage">
              {item.when}
            </p>
            <p class="mt-3 text-lg text-ink md:text-xl">{item.what}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Proof points -->
  <section class="border-t border-ink/10 px-6 py-20 md:py-28">
    <div class="mx-auto grid max-w-container gap-12 md:grid-cols-[1fr_1.2fr]">
      <div>
        <h2 class="text-sm uppercase tracking-[0.18em] text-clay">
          Built for real programming
        </h2>
        <p class="mt-3 text-3xl font-medium tracking-tight text-ink md:text-4xl">
          Not a workout app pretending to coach.
        </p>
      </div>
      <ul class="space-y-5 text-lg text-ink/80">
        {proofPoints.map((p) => (
          <li class="flex gap-3">
            <span aria-hidden="true" class="mt-2 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-sage" />
            <span>{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Social proof -->
  <Testimonials />

  <!-- Built by a coach -->
  <section class="border-t border-ink/10 px-6 py-20 md:py-28">
    <div class="mx-auto grid max-w-container gap-10 md:grid-cols-[1fr_1.3fr] md:items-center">
      <div>
        <h2 class="text-sm uppercase tracking-[0.18em] text-clay">Built by a coach</h2>
        <p class="mt-3 text-3xl font-medium tracking-tight text-ink md:text-4xl">
          I built Deload because I needed it.
        </p>
      </div>
      <div class="space-y-5 text-lg text-ink/75">
        <p>
          I'm Derek &mdash; I coached at Equinox, earned my Precision Nutrition cert, then went out on my own with the teams at Sportslab NYC and Fitness360NYC, programming for everyone from gen-pop and weight-loss clients to marathoners and competitive lifters.
        </p>
        <p>
          I started automating my own programming the moment I realized how far AI can go in the hands of someone who already knows the craft. Getting from an AI draft to something you can actually run on the gym floor? Nobody had done it &mdash; honestly, still hasn't, whatever the competition advertises. So I built it.
        </p>
        <a href={`${root}/about`} class="inline-block font-medium text-ink underline underline-offset-4 transition-colors hover:text-clay">Read the full story &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="border-t border-ink/10 px-6 py-24 md:py-32">
    <div class="mx-auto max-w-container text-center">
      <h2 class="mx-auto max-w-2xl text-balance text-3xl font-medium tracking-tight text-ink md:text-5xl">
        Get your Sunday back.
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-ink/70">
        Book a 15-minute demo and we'll write your first program live &mdash; or join the waitlist for the private beta.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href={`${root}/book-a-demo`}
          class="inline-block rounded-full bg-ink px-6 py-3 text-sm font-medium text-bg transition-colors hover:bg-ink/90"
        >Book a demo</a>
        <a
          href={PRIMARY_CTA.href}
          class="inline-block rounded-full border border-ink/15 px-6 py-3 text-sm font-medium text-ink transition-colors hover:bg-ink/5"
        >{PRIMARY_CTA.label}</a>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    const el = document.getElementById("hero-noun");
    if (!el) return;
    const reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) return;
    const nouns = (el.getAttribute("data-nouns") || "").split(",").map(function (n) { return n.trim(); }).filter(Boolean);
    if (nouns.length < 2) return;
    let i = 0;
    el.style.transition = "opacity 350ms ease";
    setInterval(function () {
      el.style.opacity = "0";
      setTimeout(function () {
        i = (i + 1) % nouns.length;
        el.textContent = nouns[i];
        el.style.opacity = "1";
      }, 350);
    }, 2200);
  })();
</script>
