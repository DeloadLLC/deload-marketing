---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Arrow from "../../components/Arrow.astro";
import { RESOURCES, faqs, getResource } from "../../config";

export function getStaticPaths() {
  return RESOURCES.map((r) => ({ params: { slug: r.slug } }));
}

const { slug } = Astro.params;
const resource = getResource(slug!)!;
const base = import.meta.env.BASE_URL;
const root = base.replace(/\/$/, "");
const isSupport = resource.slug === "support";
---
<Layout title={resource.nav} description={resource.intro}>
  <PageHero label={resource.eyebrow} title={resource.title} intro={resource.intro} soon={resource.comingSoon} />

  {resource.body && (
    <section class="wrap pb-16">
      <div class="max-w-[65ch] space-y-5 border-t border-rule pt-10 text-[1.125rem] leading-relaxed text-ink lg:ml-[calc(14rem+3rem)]">
        {resource.body.map((p) => <p>{p}</p>)}
        <p class="pt-2">
          <a href={`${root}/elevate`} class="link-arrow">Explore Deload Foundations <Arrow /></a>
        </p>
      </div>
    </section>
  )}

  {resource.comingSoon && (
    <section class="wrap pb-24">
      <div class="rounded-[20px] bg-sunk px-6 py-10 sm:px-10 md:px-14 md:py-14">
        <p class="max-w-[52ch] text-[1.25rem] leading-snug text-ink">
          We're putting this together. In the meantime,
          <a href={`${root}/book-a-demo`} class="link">book a demo</a>
          or <a href={`${root}/contact`} class="link">drop us a note</a>
          and we'll keep you posted.
        </p>
      </div>
    </section>
  )}

  {isSupport && (
    <section class="wrap pb-24">
      <dl class="border-t border-rule">
        {faqs.map((f) => (
          <div class="grid gap-3 border-b border-rule py-8 md:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] md:gap-12">
            <dt class="text-[1.25rem] font-semibold leading-snug tracking-[-0.02em] text-ink">{f.q}</dt>
            <dd class="text-[1.0625rem] text-muted">{f.a}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-10 text-[1.125rem] text-muted">
        Still stuck?
        <a href={`${root}/contact`} class="link">Contact us</a>
        &mdash; we read everything.
      </p>
    </section>
  )}
</Layout>
