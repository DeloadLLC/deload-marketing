---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Arrow from "../../components/Arrow.astro";
import { RESOURCES } from "../../config";

const base = import.meta.env.BASE_URL;
const root = base.replace(/\/$/, "");
---
<Layout
  title="Resources"
  description="Guides on starting and funding your coaching business, plus the blog, webinars, and support — everything around running the business, not just the software."
>
  <PageHero
    title="Help with the business, not just the software."
    intro="Starting out, finding funding, or looking for answers — here's where to begin."
  />

  <section class="wrap pb-24">
    <ul class="border-t border-rule">
      {RESOURCES.map((r) => (
        <li class="border-b border-rule">
          <a href={`${root}/resources/${r.slug}`} class="group grid gap-2 py-7 md:grid-cols-[minmax(0,1fr)_auto] md:items-baseline md:gap-12">
            <span>
              <span class="flex flex-wrap items-center gap-2 text-[clamp(1.5rem,1.2rem+1vw,2rem)] font-semibold leading-tight tracking-[-0.03em] text-ink transition-colors group-hover:text-clay">
                {r.nav}{r.comingSoon && <span class="soon">Coming soon</span>}
              </span>
              <span class="mt-1.5 block text-muted">{r.menuBlurb}</span>
            </span>
            <Arrow class="hidden h-6 w-6 text-muted transition-transform group-hover:translate-x-1 group-hover:text-ink md:block" />
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
