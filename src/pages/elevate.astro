---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { PRIMARY_CTA } from "../config";

const base = import.meta.env.BASE_URL;
const root = base.replace(/\/$/, "");

const pillars = [
  {
    title: "Start from zero",
    body: "Programming, billing, booking and your athlete app set up from day one, plus pointers to funding and operations help.",
  },
  {
    title: "Migrate without the mess",
    body: "We'll help move your clients, programs and packages over so nothing drops between tools.",
  },
  {
    title: "Grow with a real platform",
    body: "Team defaults, shared protocols, reporting and white-label when you add coaches.",
  },
];

const steps = [
  { n: "01", t: "Tell us where you are", d: "New or migrating, solo or a team." },
  { n: "02", t: "Set up the platform", d: "Configured to how you work." },
  { n: "03", t: "Move your clients over", d: "Athletes, programs and packages, from any tool or spreadsheet." },
  { n: "04", t: "Launch and grow", d: "Go live with a calmer week." },
];

// No competitor names in public copy (founder, 2026-11-12).
const migrations = ["Spreadsheets", "Word docs", "PDFs", "Other coaching apps"];
---

<Layout
  title="Deload Foundations"
  description="Deload Foundations helps you open and grow your coaching business, from standing up a brand-new studio to moving an existing roster over from spreadsheets or another coaching app."
>
  <PageHero
    title="Open and grow your coaching business with confidence."
    intro="Help starting a coaching business from scratch, or moving over from another tool without losing momentum. Opens after the private beta."
    soon
    wide
  >
    <a href={`${root}/book-a-demo`} class="btn btn-pri btn-lg">Talk to us</a>
    <a href={PRIMARY_CTA.href} class="btn btn-lg">{PRIMARY_CTA.label}</a>
  </PageHero>

  <section class="field">
    <div class="wrap py-20 md:py-24">
      <ul class="grid gap-y-10 md:grid-cols-3 md:gap-x-10">
        {pillars.map((p) => (
          <li class="border-t border-rule/50 pt-6">
            <h2 class="text-[1.75rem] font-semibold leading-tight tracking-[-0.03em] text-ink">{p.title}</h2>
            <p class="mt-4 text-muted">{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wrap py-20 md:py-24">
    <div>
      <div>
        <h2 class="h2 text-ink">From wherever you are to live.</h2>
        <ol class="mt-10 grid border-t border-rule sm:grid-cols-2 lg:grid-cols-4">
          {steps.map((s) => (
            <li class="border-b border-rule py-6 pr-6 lg:border-b-0">
              <h3 class="mt-1 text-[1.125rem] font-semibold tracking-[-0.01em] text-ink">{s.t}</h3>
              <p class="mt-2 text-[0.9375rem] text-muted">{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="border-t border-rule">
    <div class="wrap py-20 md:py-24">
      <div>
        <h2 class="h2 max-w-[20ch] text-ink">Coming from another tool? We've got you.</h2>
        <p class="lede mt-5">
          Import your programs from Excel, Word or PDF today. Hands-on help moving your roster and
          packages comes with Foundations.
        </p>
        <ul class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
          {migrations.map((m) => (
            <li class="text-[clamp(1.375rem,1.1rem+0.9vw,1.875rem)] font-semibold tracking-[-0.03em] text-muted">{m}</li>
          ))}
        </ul>
        <div class="mt-10">
          <a href={`${root}/book-a-demo`} class="btn btn-pri btn-lg">Plan your migration</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
