---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { PRIMARY_CTA } from "../config";

const base = import.meta.env.BASE_URL;
const root = base.replace(/\/$/, "");

const pillars = [
  {
    title: "Start from zero",
    body: "Going independent or opening your first space? We help you stand up programming, billing, booking, and your athlete app from day one — and point you to funding and operations help along the way.",
  },
  {
    title: "Migrate without the mess",
    body: "Already running on Arketa, Jane, Mindbody, or a stack of spreadsheets? We'll help you move clients, programs, and packages over so nothing drops between tools.",
  },
  {
    title: "Grow with a real platform",
    body: "As you add athletes and coaches, the platform scales with you — org defaults, shared protocols, reporting, and white-label client surfaces when you're ready.",
  },
];

const steps = [
  { n: "01", t: "Tell us where you are", d: "New business or migrating, solo or a team — we start from your actual situation." },
  { n: "02", t: "Set up the platform", d: "Programming, billing, booking, check-ins, and the athlete app, configured to how you work." },
  { n: "03", t: "Move your clients over", d: "Bring athletes, programs, and packages across from your old tool or spreadsheets." },
  { n: "04", t: "Launch and grow", d: "Go live with a calmer week — and a platform that grows as the roster does." },
];

const migrations = ["Arketa", "Jane App", "Mindbody", "TrueCoach", "TrainHeroic", "Spreadsheets"];
---

<Layout
  title="Deload Foundations"
  description="Deload Foundations helps you open and grow your coaching business — from standing up a brand-new studio to migrating an existing roster over from Arketa, Jane, Mindbody, or spreadsheets."
>
  <PageHero
    label="Deload Foundations"
    title="Open and grow your coaching business with confidence."
    intro="Deload Foundations is how we'll help coaches start a business from scratch — and help established coaches move over from another tool without losing momentum. The platform handles the work; Foundations will help you build the business around it. It opens after the private beta."
    soon
    wide
  >
    <a href={`${root}/book-a-demo`} class="btn btn-pri btn-lg">Talk to us</a>
    <a href={PRIMARY_CTA.href} class="btn btn-lg">{PRIMARY_CTA.label}</a>
  </PageHero>

  <section class="field">
    <div class="wrap py-20 md:py-24">
      <ul class="grid gap-y-10 md:grid-cols-3 md:gap-x-10">
        {pillars.map((p) => (
          <li class="border-t border-rule/50 pt-6">
            <h2 class="text-[1.75rem] font-semibold leading-tight tracking-[-0.03em] text-ink">{p.title}</h2>
            <p class="mt-4 text-muted">{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wrap py-20 md:py-24">
    <div class="grid gap-6 lg:grid-cols-[14rem_1fr] lg:gap-12">
      <p class="label pt-2">How it works</p>
      <div>
        <h2 class="h2 text-ink">From wherever you are to live.</h2>
        <ol class="mt-10 grid border-t border-rule sm:grid-cols-2 lg:grid-cols-4">
          {steps.map((s) => (
            <li class="border-b border-rule py-6 pr-6 lg:border-b-0">
              <p class="num text-[2.5rem] font-medium leading-none text-clay">{s.n}</p>
              <h3 class="mt-5 text-[1.125rem] font-semibold tracking-[-0.01em] text-ink">{s.t}</h3>
              <p class="mt-2 text-[0.9375rem] text-muted">{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="border-t border-rule">
    <div class="wrap grid gap-6 py-20 md:py-24 lg:grid-cols-[14rem_1fr] lg:gap-12">
      <p class="label pt-2">Migrating over</p>
      <div>
        <h2 class="h2 max-w-[20ch] text-ink">Coming from another tool? We've got you.</h2>
        <p class="lede mt-5">
          Moving from one of the tools below? Today you can import your programs from Excel, Word or PDF;
          hands-on help bringing your roster and packages across comes with Foundations.
        </p>
        <ul class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
          {migrations.map((m) => (
            <li class="text-[clamp(1.375rem,1.1rem+0.9vw,1.875rem)] font-semibold tracking-[-0.03em] text-muted">{m}</li>
          ))}
        </ul>
        <div class="mt-10">
          <a href={`${root}/book-a-demo`} class="btn btn-pri btn-lg">Plan your migration</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
