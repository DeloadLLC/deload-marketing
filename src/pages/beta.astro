---
import Layout from "../layouts/Layout.astro";
import BetaSignupForm from "../components/BetaSignupForm.astro";
import { FOUNDERS_OFFER } from "../config";

const betaPerks = [...FOUNDERS_OFFER.perks, "A direct line to the founder"];

const svgAttrs =
  'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"';
const check = `<svg class="h-5 w-5" ${svgAttrs}><path d="M20 6 9 17l-5-5"/></svg>`;
---
<Layout
  title="Join the Deload beta"
  description="Join the waitlist: early access to Deload, the exclusive Founders Rate (Solo at $99/mo) and 25% off a future upgrade. Generate block-aware programs with simple AI chat, manage your clients, and ship to your athletes' phones."
  minimalNav={true}
  hideHeaderCtas={true}
>
  <section class="wrap pt-12 pb-16 md:pt-20 md:pb-24">
    <div class="grid items-start gap-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-16">
      <div>
        <p class="label flex items-center gap-2"><span aria-hidden="true" class="inline-block h-2 w-2 rounded-full bg-sage"></span>Now in private beta</p>
        <h1 class="display mt-5 max-w-[12ch] text-ink">Coach more. Lose fewer evenings.</h1>
        <p class="lede mt-6">
          Deload is the all-in-one AI coaching platform. Generate block-aware programs with
          simple AI chat, manage your clients, and grow your business.
        </p>
        <p class="mt-8 text-[1.0625rem] font-medium text-ink">{FOUNDERS_OFFER.pitch}</p>
        <ul class="rows mt-5">
          {betaPerks.map((perk) => (
            <li class="flex items-start gap-3 !py-3.5 text-ink">
              <span class="mt-0.5 shrink-0 text-sage" set:html={check} />
              <span>{perk}</span>
            </li>
          ))}
        </ul>
        <p class="mt-6 max-w-[62ch] text-[0.8125rem] leading-relaxed text-muted" data-testid="founders-fine-print">{FOUNDERS_OFFER.finePrint}</p>
      </div>

      <div class="lg:sticky lg:top-8">
        <div class="mb-5">
          <h2 class="h3 text-[1.75rem] text-ink">Join the waitlist</h2>
          <p class="mt-1 text-muted">We invite coaches in small groups. It takes a minute.</p>
        </div>
        <BetaSignupForm id="beta-form" submitLabel="Join Waitlist" />
      </div>
    </div>
  </section>
</Layout>
