---
import Layout from "../layouts/Layout.astro";
import Forward from "../components/Forward.astro";
import BetaSignupForm from "../components/BetaSignupForm.astro";
import Shot from "../components/Shot.astro";
import { FOUNDERS_OFFER, IS_OPEN, SIGN_UP_URL } from "../config";

// With open sign-up there is no waitlist: this page forwards to sign-up
// (founder, 2026-11-12).

const betaPerks = [...FOUNDERS_OFFER.perks, "A direct line to the founder"];

const svgAttrs =
  'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"';
const check = `<svg class="h-5 w-5" ${svgAttrs}><path d="M20 6 9 17l-5-5"/></svg>`;
---
{IS_OPEN ? <Forward to={SIGN_UP_URL} title="Start your free trial" /> : (
<Layout
  title="Join the Deload beta"
  description="Join the waitlist: early access to Deload, the Founders Rate (Solo at $99/mo) and 25% off a future upgrade. Get block-aware programs written in your voice, manage your clients, and ship to your athletes' phones."
  minimalNav={true}
  hideHeaderCtas={true}
>
  <!-- Hero (Form): the head and what you get on the left, the form on the
       right from 60rem; on phones the form comes right after the head. -->
  <section class="wrap pt-12 pb-16 md:pt-16 md:pb-24">
    <div class="form-page">
      <div class="fp-head">
        <h1 class="display-sm max-w-[12ch] text-ink">Coach more. Lose fewer evenings.</h1>
        <p class="lede mt-6">
          The all-in-one AI coaching platform: block-aware programs in your voice, your clients
          and your business in one place.
        </p>
      </div>

      <div class="fp-form">
        <div class="mb-5">
          <h2 class="h3 text-[1.75rem] text-ink">Join the waitlist</h2>
          <p class="mt-1 text-muted">We invite coaches in small groups. It takes a minute.</p>
        </div>
        <BetaSignupForm id="beta-form" submitLabel="Join Waitlist" />
      </div>

      <div class="fp-more">
        <p class="text-[1.0625rem] font-medium text-ink">Join the waitlist and you get:</p>
        <ul class="rows mt-5">
          {betaPerks.map((perk) => (
            <li class="flex items-start gap-3 !py-3.5 text-ink">
              <span class="mt-0.5 shrink-0 text-sage" set:html={check} />
              <span>{perk}</span>
            </li>
          ))}
        </ul>
        <p class="mt-6 max-w-[62ch] text-[0.8125rem] leading-relaxed text-muted" data-testid="founders-fine-print">{FOUNDERS_OFFER.finePrint}</p>
      </div>
    </div>
  </section>

  <!-- The product: one capture across the container -->
  <section class="border-t border-rule py-20 md:py-32" aria-labelledby="beta-shot-title">
    <div class="wrap">
      <h2 id="beta-shot-title" class="h2 max-w-[18ch] text-ink">Start from a sentence.</h2>
      <figure class="mt-10 md:mt-14">
        <Shot
          name="coach-generate-brief"
          dark
          width={2880}
          height={1800}
          alt="Deload's Generate screen: a brief for a 4-week strength block, with the weeks, days, length, equipment and a left-knee caution picked out of it."
          ratioSm="4 / 3"
          zoomSm={1.9}
          fx={0.62}
          shiftYSm={0.06}
        />
        <figcaption class="mt-3 max-w-[60ch] text-[0.9375rem] text-muted">Describe the athlete; Deload picks out the weeks, days, length, equipment and limits, then drafts the program for you to edit.</figcaption>
      </figure>
    </div>
  </section>
</Layout>
)}
