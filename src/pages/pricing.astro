---
import Layout from "../layouts/Layout.astro";
import { BETA_OFFERS, FOUNDERS_OFFER, PAYMENTS_NOTE, PRICING, PRIMARY_CTA, SHOW_PRICES, faqs } from "../config";

const base = import.meta.env.BASE_URL;
const root = base.replace(/\/$/, "");

const resolveHref = (href: string) =>
  href === "" ? PRIMARY_CTA.href : href.startsWith("http") ? href : `${root}${href}`;
---
<Layout
  title="Pricing"
  description={SHOW_PRICES
    ? "Simple monthly pricing for you or your team: Solo $149, Pro $199, Elite $249, and $79 or $99 a month for each coach on a Pro or Elite team. Waitlist and beta coaches get the Founders Rate — Solo at $99/mo — plus 25% off one upgrade. Book a demo for multi-location pricing."
    : "Deload is in private beta. Beta coaches use it free while the beta runs and get the Founders Rate at launch. Join the waitlist or book a demo."}
>
  {!SHOW_PRICES && (
    <section class="wrap pt-14 pb-16 md:pt-24 md:pb-24" data-testid="pricing-beta">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:items-end lg:gap-16">
        <div>
          <h1 class="display max-w-[14ch] text-ink">Pricing opens after the private beta.</h1>
          <p class="lede mt-6">
            Beta coaches, and the coaches on their team, use Deload free while it runs. At launch you keep the Founders Rate and get 25% off one upgrade.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-2.5">
            <a href={PRIMARY_CTA.href} class="btn btn-pri btn-lg">{PRIMARY_CTA.label}</a>
            <a href={`${root}/book-a-demo`} class="btn btn-lg">Book a demo</a>
          </div>
        </div>
        <div class="ink-field rounded-[20px] px-6 py-8 sm:px-8 md:py-10">
          <p class="label">Founders Rate, Solo plan</p>
          <p class="mt-4 flex items-baseline gap-3">
            <span class="num text-[clamp(3.5rem,2.5rem+4vw,5.5rem)] font-medium leading-none tracking-[-0.06em] text-ink">$99</span>
            <span class="num text-[1.125rem] text-muted">/mo</span>
          </p>
          <p class="mt-3 text-muted">instead of <span class="num">$149</span>, for as long as you keep it.</p>
          <p class="mt-6 border-t border-rule pt-5 text-ink">Your athletes use Deload free.</p>
        </div>
      </div>
      <p class="mt-10 max-w-[72ch] text-[0.8125rem] leading-relaxed text-muted" data-testid="founders-fine-print">{FOUNDERS_OFFER.finePrint}</p>
    </section>
  )}

  {SHOW_PRICES && (<>
  <section class="wrap pt-14 pb-8 md:pt-24">
    <h1 class="display max-w-[14ch] text-ink">Simple pricing for you or your team.</h1>
    <p class="lede mt-6">
      Monthly, no annual lock-in. Waitlist and beta coaches get the Founders Rate. Upgrade as you grow. Your athletes use Deload free.
    </p>
  </section>

  <!-- Toggle -->
  <section class="wrap">
    <div id="plan-toggle" class="inline-flex items-center gap-1 rounded-[12px] border border-rule bg-surface p-1" role="tablist" aria-label="Plan audience">
      <button data-plan="individuals" role="tab" aria-selected="true" class="plan-tab min-h-[40px] rounded-[9px] px-5 text-[0.9375rem] font-semibold transition-colors">Individuals</button>
      <button data-plan="teams" role="tab" aria-selected="false" class="plan-tab min-h-[40px] rounded-[9px] px-5 text-[0.9375rem] font-semibold transition-colors">Teams</button>
    </div>
  </section>

  <!-- Cards -->
  <section class="wrap pt-10 pb-20">
    <div>
      {(["individuals", "teams"] as const).map((plan) => (
        <div class="plan-panel" data-panel={plan} hidden={plan !== "individuals"}>
          {BETA_OFFERS[plan] && (
            <div class="mb-10 flex flex-col items-start gap-5 rounded-[20px] bg-sunk p-6 md:flex-row md:items-center md:justify-between md:p-8">
              <div>
                <p class="h3 text-ink">{BETA_OFFERS[plan]!.headline}</p>
                <p class="mt-2 max-w-[62ch] text-muted">{BETA_OFFERS[plan]!.body}</p>
              </div>
              <a
                href={resolveHref(BETA_OFFERS[plan]!.cta.href)}
                class="btn btn-pri btn-lg"
              >
                {BETA_OFFERS[plan]!.cta.label}
              </a>
            </div>
          )}
          <p class="label mb-6">
            {plan === "individuals"
              ? "Individual tiers — standard monthly pricing"
              : "Team plans — your plan, plus a seat for each Coach or Admin. Viewers are free."}
          </p>
          <div class="grid border-t border-rule md:grid-cols-3">
            {PRICING[plan].map((tier) => (
              <div class:list={["relative flex flex-col border-b border-rule py-8 md:border-b-0 md:border-r md:px-8 md:first:pl-0 md:last:border-r-0 md:last:pr-0", tier.highlight && "tier-hl"]}>
                <p class="flex items-center gap-2">
                  <span class="text-[1.375rem] font-semibold tracking-[-0.02em] text-ink">{tier.name}</span>
                  {tier.badge && <span class="rounded-full bg-ink px-2.5 py-0.5 text-[0.75rem] font-semibold text-bg">{tier.badge}</span>}
                </p>
                <p class="mt-5 flex items-baseline gap-1.5">
                  <span class="num text-[3.25rem] font-medium leading-none tracking-[-0.06em] text-ink">{tier.price}</span>
                  {tier.cadence && <span class="num text-muted">{tier.cadence}</span>}
                </p>
                {tier.perSeat && <p class="num mt-2 text-[0.9375rem] font-medium text-ink" data-testid="tier-per-seat">{tier.perSeat}</p>}
                <p class="mt-4 text-[0.9375rem] text-muted">{tier.blurb}</p>
                <a href={resolveHref(tier.cta.href)} class:list={["btn btn-lg mt-6", tier.highlight && "btn-pri"]}>{tier.cta.label}</a>
                <ul class="mt-7 space-y-2.5 text-[0.9375rem] text-ink">
                  {tier.features.map((f) => (
                    <li class="flex gap-2.5">
                      <svg class="mt-1 h-4 w-4 shrink-0 text-sage" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3.5 8.3 2.8 2.8 6.2-6.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      ))}
      <p class="mt-10 max-w-[72ch] text-[0.9375rem] text-muted">
        {PAYMENTS_NOTE} Multi-location enterprise plans are
        custom — <a href={`${root}/book-a-demo`} class="link">book a demo</a> for a quote.
      </p>
      <p class="mt-4 max-w-[72ch] text-[0.8125rem] leading-relaxed text-muted" data-testid="founders-fine-print">{FOUNDERS_OFFER.finePrint}</p>
    </div>
  </section>
  </>)}

  <!-- FAQ -->
  <section class="border-t border-rule">
    <div class="wrap py-20 md:py-24">
      <div>
        <h2 class="h2 text-ink">Common questions.</h2>
        <dl class="mt-10 border-t border-rule">
          {faqs.map((f) => (
            <div class="grid gap-3 border-b border-rule py-7 md:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] md:gap-10">
              <dt class="text-[1.1875rem] font-semibold leading-snug tracking-[-0.015em] text-ink">{f.q}</dt>
              <dd class="text-muted">{f.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>
</Layout>

<style>
  .plan-tab { color: rgb(var(--c-muted)); }
  .plan-tab:hover { color: rgb(var(--c-ink)); }
  .plan-tab[aria-selected="true"] { background: rgb(var(--c-ink)); color: rgb(var(--c-bg)); }
</style>

<script is:inline>
  (function () {
    var tabs = Array.prototype.slice.call(document.querySelectorAll(".plan-tab"));
    var panels = Array.prototype.slice.call(document.querySelectorAll(".plan-panel"));
    function select(plan) {
      tabs.forEach(function (t) { t.setAttribute("aria-selected", String(t.getAttribute("data-plan") === plan)); });
      panels.forEach(function (p) { p.hidden = p.getAttribute("data-panel") !== plan; });
    }
    tabs.forEach(function (t) {
      t.addEventListener("click", function () { select(t.getAttribute("data-plan")); });
    });
  })();
</script>
