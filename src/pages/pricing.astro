---
import Layout from "../layouts/Layout.astro";
import { BETA_OFFERS, FOUNDERS_OFFER, IS_OPEN, PAYMENTS_NOTE, PRICING, PRIMARY_CTA, SHOW_PRICES, TRIAL_DAYS, faqs } from "../config";

const base = import.meta.env.BASE_URL;
const root = base.replace(/\/$/, "");

const resolveHref = (href: string) =>
  href === "" ? PRIMARY_CTA.href : href.startsWith("http") ? href : `${root}${href}`;

const description = !SHOW_PRICES
  ? "Deload is in private beta. Beta coaches use it free while the beta runs and get the Founders Rate at launch. Join the waitlist or book a demo."
  : IS_OPEN
    ? `Simple monthly pricing for you or your team, with a ${TRIAL_DAYS}-day free trial: Solo $149, Pro $199, Elite $249, and $79 or $99 a month for each coach on a Pro or Elite team. The Founders Rate puts Solo at $99/mo while it lasts. Book a demo for multi-location pricing.`
    : "Simple monthly pricing for you or your team: Solo $149, Pro $199, Elite $249, and $79 or $99 a month for each coach on a Pro or Elite team. Waitlist and beta coaches get the Founders Rate (Solo at $99/mo) plus 25% off one upgrade. Book a demo for multi-location pricing.";
const pricesLede = IS_OPEN
  ? `Monthly, no annual lock-in, and every plan starts with a ${TRIAL_DAYS}-day free trial. Your athletes use Deload free.`
  : "Monthly, no annual lock-in. Waitlist and beta coaches get the Founders Rate. Upgrade as you grow. Your athletes use Deload free.";
---
<Layout
  title="Pricing"
  description={description}
>
  {!SHOW_PRICES && (
    <section class="wrap pt-14 pb-16 md:pt-24 md:pb-24" data-testid="pricing-beta">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:items-end lg:gap-16">
        <div>
          <h1 class="display max-w-[14ch] text-ink">Pricing opens after the private beta.</h1>
          <p class="lede mt-6">
            Beta coaches, and the coaches on their team, use Deload free while it runs. At launch you keep the Founders Rate and get 25% off one upgrade.
          </p>
          <div class="mt-8">
            <a href={PRIMARY_CTA.href} class="btn btn-pri btn-lg">{PRIMARY_CTA.label}</a>
          </div>
        </div>
        <div class="ink-field rounded-[20px] px-6 py-8 sm:px-8 md:py-10">
          <p class="label">Founders Rate, Solo plan</p>
          <p class="mt-4 flex items-baseline gap-3">
            <span class="num text-[clamp(3.5rem,2.5rem+4vw,5.5rem)] font-medium leading-none tracking-[-0.06em] text-ink">$99</span>
            <span class="num text-[1.125rem] text-muted">/mo</span>
          </p>
          <p class="mt-3 text-muted">instead of <span class="num">$149</span>, for as long as you keep it.</p>
          <p class="mt-6 border-t border-rule pt-5 text-ink">Your athletes use Deload free.</p>
        </div>
      </div>
      <p class="mt-10 max-w-[72ch] text-[0.8125rem] leading-relaxed text-muted" data-testid="founders-fine-print">{FOUNDERS_OFFER.finePrint}</p>
    </section>
  )}

  {SHOW_PRICES && (<>
  <!-- Hero (Banner): the head, the offer in one line, the plan switch; the
       tiers start inside the first screen. -->
  <section class="wrap pt-14 md:pt-20">
    <div class="price-head">
      <h1 class="display-sm max-w-[16ch] text-ink">Simple pricing for you or your team.</h1>
      <p class="lede">{pricesLede}</p>
    </div>
    <div id="plan-toggle" class="mt-10 inline-flex items-center gap-1 rounded-[12px] border border-rule bg-surface p-1" role="tablist" aria-label="Plan audience">
      <button type="button" data-plan="individuals" role="tab" aria-selected="true" class="plan-tab min-h-[44px] rounded-[9px] px-5 text-[0.9375rem] font-semibold">Individuals</button>
      <button type="button" data-plan="teams" role="tab" aria-selected="false" class="plan-tab min-h-[44px] rounded-[9px] px-5 text-[0.9375rem] font-semibold">Teams</button>
    </div>
  </section>

  <!-- Tiers: hairline columns, no cards; each tier's parts sit on shared rows
       so the buttons line up. -->
  <section class="wrap pt-8 pb-24 md:pb-32">
    <div>
      {(["individuals", "teams"] as const).map((plan) => (
        <div class="plan-panel" data-panel={plan} hidden={plan !== "individuals"}>
          {plan === "teams" && (
            <p class="mb-6 max-w-[62ch] text-[0.9375rem] text-muted">
              A team is your plan plus a seat for each Coach or Admin. Viewers are free.
            </p>
          )}
          <div class="tiers">
            {PRICING[plan].map((tier) => (
              <div class:list={["tier", tier.highlight && "tier-hl"]}>
                <p class="flex flex-wrap items-center gap-2">
                  <span class="text-[1.375rem] font-semibold tracking-[-0.02em] text-ink">{tier.name}</span>
                  {tier.badge && <span class="rounded-full bg-ink px-2.5 py-0.5 text-[0.75rem] font-semibold text-bg">{tier.badge}</span>}
                </p>
                <div>
                  <p class="flex items-baseline gap-1.5">
                    <span class="num text-[clamp(3rem,2.4rem+1.6vw,4rem)] font-medium leading-none tracking-[-0.06em] text-ink">{tier.price}</span>
                    {tier.cadence && <span class="num text-muted">{tier.cadence}</span>}
                  </p>
                  {tier.perSeat && <p class="num mt-2 text-[0.9375rem] font-medium text-ink" data-testid="tier-per-seat">{tier.perSeat}</p>}
                </div>
                <p class="text-[0.9375rem] text-muted">{tier.blurb}</p>
                {tier.cta.href === "" ? (
                  <a href={resolveHref(tier.cta.href)} class:list={["btn btn-lg", tier.highlight && "btn-pri"]}>{tier.cta.label}</a>
                ) : (
                  <!-- Custom plans have no sign-up: a link, not a button. -->
                  <p class="flex min-h-[52px] items-center"><a href={resolveHref(tier.cta.href)} class="link">{tier.cta.label}</a></p>
                )}
                <ul class="space-y-2.5 text-[0.9375rem] text-ink">
                  {tier.features.map((f) => typeof f === "string" ? (
                    <li class="flex gap-2.5">
                      <svg class="mt-1 h-4 w-4 shrink-0 text-sage" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3.5 8.3 2.8 2.8 6.2-6.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      <span>{f}</span>
                    </li>
                  ) : (
                    <li class="flex flex-wrap items-center gap-2 pl-[1.625rem] text-muted">
                      <span>{f.label}</span>
                      <span class="soon">Soon</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          {BETA_OFFERS[plan] && (
            <div class="offer">
              <div>
                <p class="h3 max-w-[30ch] text-ink">{BETA_OFFERS[plan]!.headline}</p>
                <p class="mt-2 max-w-[62ch] text-muted">{BETA_OFFERS[plan]!.body}</p>
              </div>
              <a href={resolveHref(BETA_OFFERS[plan]!.cta.href)} class="btn btn-lg">{BETA_OFFERS[plan]!.cta.label}</a>
            </div>
          )}
        </div>
      ))}
      <p class="mt-12 max-w-[68ch] text-[0.9375rem] text-muted">
        {PAYMENTS_NOTE} Multi-location enterprise plans are
        custom: <a href={`${root}/book-a-demo`} class="link">book a demo</a> for a quote.
      </p>
      <p class="mt-4 max-w-[68ch] text-[0.8125rem] leading-relaxed text-muted" data-testid="founders-fine-print">{FOUNDERS_OFFER.finePrint}</p>
    </div>
  </section>
  </>)}

  <!-- Questions: the head on the left, the answers as rows beside it -->
  <section class="border-t border-rule">
    <div class="wrap faq py-20 md:py-32">
      <h2 class="h2 text-ink">Common questions.</h2>
      <dl class="border-t border-rule">
        {faqs.map((f) => (
          <div class="grid gap-2 border-b border-rule py-6 md:py-7">
            <dt class="text-[1.1875rem] font-semibold leading-snug tracking-[-0.015em] text-ink">{f.q}</dt>
            <dd class="max-w-[60ch] text-muted">{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Layout>

<style>
  .price-head { display: grid; gap: var(--space-md); }
  @media (min-width: 60rem) {
    .price-head { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: var(--space-2xl); align-items: end; }
  }
  .tiers { display: grid; border-top: 1px solid rgb(var(--c-rule)); }
  .tier {
    display: grid;
    gap: var(--space-md);
    align-content: start;
    padding-block: var(--space-xl);
    border-bottom: 1px solid rgb(var(--c-rule));
  }
  @media (min-width: 48rem) {
    .tiers { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(5, auto); }
    .tier {
      grid-row: span 5;
      grid-template-rows: subgrid;
      gap: var(--space-md);
      padding-inline: var(--space-xl);
      border-bottom: 0;
      border-right: 1px solid rgb(var(--c-rule));
    }
    .tier:first-child { padding-left: 0; }
    .tier:last-child { padding-right: 0; border-right: 0; }
  }
  .tier ul { padding-top: var(--space-xs); }
  .offer {
    display: grid;
    gap: var(--space-lg);
    justify-items: start;
    margin-top: var(--space-2xl);
    padding: var(--space-xl) var(--space-lg);
    border-radius: var(--radius-band);
    background: rgb(var(--c-sunk));
  }
  @media (min-width: 48rem) {
    .offer { grid-template-columns: minmax(0, 1fr) auto; align-items: center; padding: var(--space-xl); }
  }
  .faq { display: grid; gap: var(--space-xl); }
  @media (min-width: 60rem) {
    .faq { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-2xl); }
  }
  .plan-tab { color: rgb(var(--c-muted)); transition: color 160ms var(--ease-out), background-color 160ms var(--ease-out); }
  .plan-tab:hover { color: rgb(var(--c-ink)); }
  .plan-tab[aria-selected="true"] { background: rgb(var(--c-ink)); color: rgb(var(--c-bg)); }
  .plan-tab:active { transform: translateY(1px); }
  @media (prefers-reduced-motion: reduce) { .plan-tab { transition: none; } .plan-tab:active { transform: none; } }
</style>

<script is:inline>
  (function () {
    var tabs = Array.prototype.slice.call(document.querySelectorAll(".plan-tab"));
    var panels = Array.prototype.slice.call(document.querySelectorAll(".plan-panel"));
    function select(plan) {
      tabs.forEach(function (t) { t.setAttribute("aria-selected", String(t.getAttribute("data-plan") === plan)); });
      panels.forEach(function (p) { p.hidden = p.getAttribute("data-panel") !== plan; });
    }
    tabs.forEach(function (t) {
      t.addEventListener("click", function () { select(t.getAttribute("data-plan")); });
    });
  })();
</script>
