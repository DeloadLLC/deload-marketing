---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Arrow from "../../components/Arrow.astro";
import { BUSINESS_TYPES, LIVE_BUSINESS_TYPES, PRIMARY_CTA, getBusinessType } from "../../config";

export function getStaticPaths() {
  return BUSINESS_TYPES.map((b) => ({ params: { slug: b.slug } }));
}

const { slug } = Astro.params;
const biz = getBusinessType(slug!)!;
const base = import.meta.env.BASE_URL;
const root = base.replace(/\/$/, "");

const resolveHref = (href: string) =>
  href === "" ? PRIMARY_CTA.href : href.startsWith("http") ? href : `${root}${href}`;

// An empty label or href means the site's main sign-up button (Join Waitlist
// during the private beta).
const cta = biz.cta
  ? { label: biz.cta.label || PRIMARY_CTA.label, href: biz.cta.href }
  : biz.comingSoon
    ? { label: "Book a demo", href: "/book-a-demo" }
    : { label: PRIMARY_CTA.label, href: "" };
// Other live business types only; the rest are hidden until they open.
const others = LIVE_BUSINESS_TYPES.filter((b) => b.slug !== biz.slug);
---
<Layout title={biz.nav} description={biz.intro}>
  <PageHero title={biz.title} intro={biz.intro} soon={biz.comingSoon} wide>
    <p slot="after-intro" class:list={["mt-4 max-w-[58ch] text-[0.9375rem] text-muted", !biz.comingSoon && "hidden"]}>
      Opens after the private beta. Book a demo to be first in line.
    </p>
    <a href={resolveHref(cta.href)} class="btn btn-pri btn-lg">{cta.label}</a>
    <a href={`${root}/features`} class="btn btn-lg">See features</a>
  </PageHero>

  <section class="border-t border-rule">
    <div class="wrap grid gap-8 py-20 md:py-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] lg:gap-16">
      <div>
        <h2 class="h2 text-ink">Built for how you actually work.</h2>
      </div>
      <ul class="rows">
        {biz.points.map((p) => (
          <li class="text-[1.125rem] leading-snug text-ink">{p}</li>
        ))}
      </ul>
    </div>
  </section>

  {others.length > 0 && <section class="border-t border-rule">
    <div class="wrap py-16 md:py-20">
      <h2 class="label">Other business types</h2>
      <ul class="mt-6 grid border-t border-rule sm:grid-cols-2 lg:grid-cols-4">
        {others.map((b) => (
          <li class="border-b border-rule lg:border-b-0">
            <a href={`${root}/business-types/${b.slug}`} class="group flex h-full flex-col gap-1.5 py-6 pr-6">
              <span class="text-[1.125rem] font-semibold leading-snug tracking-[-0.02em] text-ink group-hover:text-clay">{b.nav}</span>
              <span class="text-[0.9375rem] text-muted">{b.menuBlurb}</span>
              <Arrow class="mt-2 text-muted group-hover:text-ink" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>}
</Layout>
