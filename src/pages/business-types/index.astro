---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Arrow from "../../components/Arrow.astro";
import { BUSINESS_TYPES } from "../../config";

const base = import.meta.env.BASE_URL;
const root = base.replace(/\/$/, "");
---
<Layout
  title="Business types"
  description="Whether you're a solo coach, opening a new business, running a single studio, scaling across locations, or white-labeling the platform, Deload fits the way you work."
>
  <PageHero
    title="From one coach to many locations."
    intro="Deload grows from a solo roster to many locations without changing tools."
  />

  <section class="wrap pb-24">
    <ul class="border-t border-rule">
      {BUSINESS_TYPES.map((b) => (
        <li class="border-b border-rule">
          <a href={`${root}/business-types/${b.slug}`} class="group grid gap-2 py-7 md:grid-cols-[minmax(0,1fr)_auto] md:items-baseline md:gap-12">
            <span>
              <span class="flex flex-wrap items-center gap-2 text-[clamp(1.5rem,1.2rem+1vw,2rem)] font-semibold leading-tight tracking-[-0.03em] text-ink transition-colors group-hover:text-clay">
                {b.nav}{b.comingSoon && <span class="soon">Coming soon</span>}
              </span>
              <span class="mt-1.5 block text-muted">{b.menuBlurb}</span>
            </span>
            <Arrow class="hidden h-6 w-6 text-muted transition-transform motion-reduce:transition-none group-hover:translate-x-1 group-hover:text-ink md:block" />
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
