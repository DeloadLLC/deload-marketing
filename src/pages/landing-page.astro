---
import Layout from "../layouts/Layout.astro";
import Forward from "../components/Forward.astro";
import BetaSignupForm from "../components/BetaSignupForm.astro";
import Testimonials from "../components/Testimonials.astro";
import Shot from "../components/Shot.astro";
import { IS_OPEN, SIGN_UP_URL, proofPoints } from "../config";

// With open sign-up there is no waitlist: the ad page forwards to sign-up
// (founder, 2026-11-12).

const highlights = proofPoints.slice(0, 4);
---
{IS_OPEN ? <Forward to={SIGN_UP_URL} title="Start your free trial" /> : (
<Layout
  title="Coach more, without losing your evenings"
  description="The all-in-one AI coaching platform. Generate block-aware programs, run your roster, and ship to your athletes' phones. Join the private beta waitlist."
  minimalNav={true}
  hideHeaderCtas={true}
  noindex={true}
>
  <!-- Hero (Form): the head and the proof points on the left, the form on
       the right from 60rem; on phones the form comes right after the head. -->
  <section class="wrap pt-12 pb-16 md:pt-16 md:pb-24">
    <div class="form-page">
      <div class="fp-head">
        <h1 class="display-sm max-w-[12ch] text-ink">More athletes. Fewer evenings.</h1>
        <p class="lede mt-6">
          Deload writes block-aware programs in your voice, brings in the ones you already have, and puts
          them on your athletes' phones.
        </p>
      </div>

      <div class="fp-form">
        <div class="mb-5">
          <h2 class="h3 text-[1.75rem] text-ink">Join the waitlist</h2>
          <p class="mt-1 text-muted">Tell us how you coach and we’ll be in touch.</p>
        </div>
        <BetaSignupForm id="landing-form" submitLabel="Join Waitlist" />
      </div>

      <div class="fp-more">
        <ul class="rows">
          {highlights.map((p) => (
            <li class="!py-3.5 text-ink">{p}</li>
          ))}
        </ul>
        <p class="mt-6 text-[0.9375rem] text-muted">Now in private beta. We invite coaches in small groups.</p>
      </div>
    </div>
  </section>

  <!-- The product: the program calendar a brief produced -->
  <section class="border-t border-rule py-20 md:py-32" aria-labelledby="lp-shot-title">
    <div class="wrap">
      <h2 id="lp-shot-title" class="h2 max-w-[18ch] text-ink">The block, on one calendar.</h2>
      <figure class="mt-10 md:mt-14">
        <Shot
          name="coach-calendar"
          dark
          width={2880}
          height={1800}
          alt="A 4-week squat and deadlift block on the Deload program calendar: four training days a week with sets, reps, percentages and RPE."
          ratio="2140 / 1600"
          zoom={1.346}
          ratioSm="1 / 1"
          zoomSm={2.4}
        />
        <figcaption class="mt-3 max-w-[60ch] text-[0.9375rem] text-muted">Weeks, days, sets, reps, %1RM and RPE. Edit any of it by hand before you assign it.</figcaption>
      </figure>
    </div>
  </section>

  <!-- Coach quotes: only real, approved ones; hidden until the API returns some. -->
  <Testimonials showPlaceholder={false} />
</Layout>
)}
