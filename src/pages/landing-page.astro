---
import Layout from "../layouts/Layout.astro";
import BetaSignupForm from "../components/BetaSignupForm.astro";
import Testimonials from "../components/Testimonials.astro";
import { proofPoints } from "../config";

const highlights = proofPoints.slice(0, 4);
---
<Layout
  title="Coach more, without losing your evenings"
  description="The all-in-one AI coaching platform. Generate block-aware programs, run your roster, and ship to your athletes' phones. Join the private beta waitlist."
  minimalNav={true}
  hideHeaderCtas={true}
  noindex={true}
>
  <section class="wrap pt-12 pb-16 md:pt-20 md:pb-24">
    <div class="grid items-start gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-16">
      <div>
        <p class="label">The all-in-one AI coaching platform</p>
        <h1 class="display mt-5 max-w-[12ch] text-ink">More athletes. Fewer evenings.</h1>
        <p class="lede mt-6">
          Deload writes block-aware training in your voice, edits with you in plain English, brings in the
          programs you already have, runs your roster, and ships the program straight to your athletes' phones
          &mdash; so you can keep the relationship and skip the spreadsheet.
        </p>
        <ul class="rows mt-8">
          {highlights.map((p) => (
            <li class="!py-3.5 text-ink">{p}</li>
          ))}
        </ul>
        <p class="mt-6 text-[0.9375rem] text-muted">Now in private beta &middot; we invite coaches in small groups</p>
      </div>

      <div class="lg:sticky lg:top-8">
        <div class="mb-5">
          <h2 class="h3 text-[1.75rem] text-ink">Join the waitlist</h2>
          <p class="mt-1 text-muted">Tell us a little about how you coach and we'll be in touch.</p>
        </div>
        <BetaSignupForm id="landing-form" submitLabel="Join Waitlist" />
      </div>
    </div>
  </section>

  <Testimonials />
</Layout>
