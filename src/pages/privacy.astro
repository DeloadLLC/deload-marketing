---
// The legal pages live in the app (one copy, kept current with the beta
// decisions); this address forwards there so old links keep working.
import { PRIVACY_URL } from "../config";
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Privacy | Deload</title>
    <style>:root { --font-sans: system-ui, sans-serif; } body { font-family: var(--font-sans); padding: 2rem; }</style>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={PRIVACY_URL} />
    <meta http-equiv="refresh" content={`0; url=${PRIVACY_URL}`} />
  </head>
  <body>
    <p>Deload's Privacy page has moved to <a href={PRIVACY_URL}>{PRIVACY_URL}</a>.</p>
  </body>
</html>
